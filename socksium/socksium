#!/bin/bash
set -Eeuo pipefail

usage="usage: socksium [-p port] [url]  (port default 1080)"
port=1080
case ${1:-} in
-h | --help)
    echo "$usage"
    exit
    ;;
-p | --port)
    if [[ ! ${2:-} =~ ^[0-9]+$ ]]
    then
        echo "Bad port '${2:-}'. $usage" >&2
        exit 1
    fi
    port=$2
    shift 2
    ;;
esac

if ! : 2>/dev/null </dev/tcp/127.0.0.1/"$port"
then
    echo "No SOCKS proxy on 127.0.0.1:$port." \
        "Start one: ssh -D $port -N -f user@host" >&2
    exit 1
fi

dir=$(mktemp -d -t socksium.XXXXXX)
trap 'rm -rf -- "$dir"' EXIT

chromium --user-data-dir="$dir" --no-first-run --no-default-browser-check \
    --proxy-server="socks5://127.0.0.1:$port" \
    --host-resolver-rules="MAP * ~NOTFOUND , EXCLUDE 127.0.0.1" \
    --force-webrtc-ip-handling-policy=disable_non_proxied_udp "$@"
