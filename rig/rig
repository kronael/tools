#!/bin/bash

dedupe(){ awk '!seen[$0]++'; }
strip_origin(){ sed 's|^origin/||'; }

recent(){
    git reflog --format='%gs' --all \
        | sed -n 's/checkout: moving from .* to //p' \
        | dedupe \
        | head -50
}

all(){
    git for-each-ref --sort=-committerdate \
        --format='%(refname:short)' refs/heads refs/remotes | grep -v '/HEAD$'
}

branches(){ { recent; all; } | strip_origin | dedupe; }

clean_branch(){
    echo "$1" | sed -E 's#^refs/(heads/|remotes/|tags/)##; s#^origin/##; s/[~^].*//'
}

get_current_branch(){
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null)
    [[ -n "$branch" ]] && { clean_branch "$branch"; return; }
    # detached HEAD — walk first-parent ancestry for a remote branch
    local c="HEAD"
    while git rev-parse --verify "$c" &>/dev/null; do
        branch=$(git for-each-ref --points-at "$c" --format='%(refname:short)' \
            refs/remotes/ | grep '/' | grep -v '/HEAD$' | head -1)
        [[ -n "$branch" ]] && { clean_branch "$branch"; return; }
        # merge commit = ambiguous ancestry, bail
        [[ $(git rev-parse --verify "$c^2" 2>/dev/null) ]] && break
        c="$c^"
    done
    echo "error: no branch found" >&2
    return 1
}

is_commit_not_branch(){
    [[ "$1" == HEAD ]] && return 0
    local branch=$(clean_branch "$1")
    git rev-parse --verify --end-of-options "$1^{commit}" &>/dev/null \
        && ! git show-ref --verify --quiet "refs/heads/$1" \
        && ! git show-ref --verify --quiet "refs/remotes/origin/$1" \
        && [[ "$1" != "refs/heads/$branch" && "$1" != "refs/remotes/origin/$branch" ]]
}

pick_branch(){
    local args=(--height=40%)
    [[ "$1" != "?" ]] && args+=(--select-1 --exit-0 --query="$1")
    awk 'FILENAME == ARGV[1] {origin[$0]=1; next}
         {sub(/^refs\/(heads\/|remotes\/|tags\/)/, ""); sub(/^origin\//, ""); sub(/[~^].*/, "")}
         $0 != "HEAD" && ($0 in origin) && !seen[$0]++' \
        <(git for-each-ref --format='%(refname:strip=3)' refs/remotes/origin) \
        <(branches) | fzf "${args[@]}"
}

BRANCH_HELP="Usage: rig %s [-z] [-n] [ref|pattern]
Flags: -z offline (no fetch), -n dry-run, ? force fzf"

cmd_branch_op(){
    local op=$1; shift

    local fetch=1 restore= dryrun= args=() restore_args=()
    [[ "$op" == gco ]] && { op=checkout; fetch=; restore=1; }
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -z|--offline) fetch=; shift ;;
            -n) dryrun=1; shift ;;
            -h|--help)
                if [[ $restore ]]; then
                    printf 'Usage: gco [-n] [ref|pattern|-]\n       gco [ref] [restore-options] -- paths\n'
                    printf 'Flags: -n dry-run, ? force fzf; no fetch\n'
                    printf 'Restore options: --ours, --theirs, -p/--patch, -m/--merge, --conflict=<style>\n'
                else
                    printf "$BRANCH_HELP\n" "$op"
                fi
                exit 0 ;;
            --)
                [[ $restore && ! $dryrun && ${#args[@]} -le 1 && $# -gt 1 ]] || {
                    echo "error: file restore requires gco [ref] -- paths"; exit 1
                }
                shift; git checkout "${restore_args[@]}" "${args[@]}" -- "$@"; return ;;
            --ours|--theirs|-p|--patch|-m|--merge|--conflict=*)
                restore_args+=("$1"); shift ;;
            -b*|-B*|-c*|-C*|-t*|--track*|--orphan*)
                echo "error: local branch creation and tracking are disabled: $1"; exit 1 ;;
            -) args+=("@{-1}"); shift ;;
            -*) echo "error: unknown flag: $1"; exit 1 ;;
            *) args+=("$1"); shift ;;
        esac
    done
    [[ ${#restore_args[@]} -eq 0 ]] || {
        echo "error: restore options require gco [ref] -- paths"; exit 1
    }
    [[ ${#args[@]} -le 1 ]] || { echo "error: expected one ref or pattern"; exit 1; }

    # Fetch before selection so fzf shows current branches
    if [[ $fetch ]]; then
        git fetch --refmap= origin '+refs/heads/*:refs/remotes/origin/*' || return
    fi

    local pattern="${args[0]:-}" branch target
    if [[ "$op" == checkout && -n "$pattern" ]] && {
        is_commit_not_branch "$pattern" ||
        { git show-ref --verify --quiet "refs/heads/${pattern#refs/heads/}" &&
          { [[ "$pattern" == refs/heads/* ]] ||
            ! git show-ref --verify --quiet "refs/remotes/origin/$pattern"; }; }
    }; then
        target="$pattern"
    else
        pattern=$(clean_branch "$pattern")
        if [[ -z "$pattern" && ("$op" == "rebase" || "$op" == "merge") ]]; then
            pattern=$(get_current_branch 2>/dev/null || true)
        fi
        branch=$(pick_branch "$pattern")
        [[ -z "$branch" ]] && {
            echo "error: no branch selected"; exit 1
        }
        target="origin/$branch"
    fi

    if [[ ${dryrun:-} ]]; then
        echo "$target"
    else
        case "$op" in
            checkout) git checkout --detach "$target" ;;
            rebase)   git rebase -i "$target" ;;
            merge)    git merge "$target" ;;
        esac
    fi
}

cmd_push(){
    while [[ "${1:-}" =~ ^- ]]; do
        case "$1" in
            -n) local dryrun=1; shift ;;
            -h|--help)
                cat <<EOF
Usage: rig push [-n] [branch|?] [commit] [git-push-flags]
       (branch and commit are order-independent; branch:commit also works)
Flags: -n dry-run, ? pick branch interactively
EOF
                exit 0 ;;
            *) break ;;
        esac
    done

    # Select branch + commit from up to two positional args, in either order:
    # a branch (or ? to pick interactively) and a commit (HEAD^, a sha, ...).
    # The branch:commit combined form still works; the rest go to git push.
    local branch="" commit="HEAD" arg
    for arg in "${1:-}" "${2:-}"; do
        [[ -z "$arg" || "$arg" == -* ]] && break
        case "$arg" in
            \?)  branch="?" ;;
            *:*) branch=$(clean_branch "${arg%:*}"); commit=${arg#*:} ;;
            *)   if is_commit_not_branch "$arg"; then commit="$arg"
                 else branch=$(clean_branch "$arg"); fi ;;
        esac
        shift
    done

    if [[ "$branch" == "?" ]]; then
        branch=$(pick_branch "?")
    elif [[ -z "$branch" ]]; then
        branch=$(get_current_branch 2>/dev/null) || branch=$(pick_branch "?")
    fi

    [[ -z "$branch" ]] && {
        echo "error: could not determine branch"
        echo "usage: rig push [branch] or rig push ?"
        exit 1
    }

    local cmd=(git push origin "$@" "$commit:refs/heads/$branch" --tags)
    if [[ ${dryrun:-} ]]; then echo "${cmd[*]}"; else "${cmd[@]}"; fi
}

symlinks=(rco rip rir rim gl gis gig gitg gp gpc gpa gw
          gif gifs gss gsp gsl grec grea gres gco gib gitsu)

cmd_install(){
    local dir=$(dirname "$(readlink -f "$0")")
    for s in "${symlinks[@]}"; do
        ln -sf rig "$dir/$s"
        echo "  $dir/$s -> rig"
    done
    echo "installed ${#symlinks[@]} symlinks"
    # Links to rig that the list does not name are leftovers of a dropped
    # alias. Only a symlink pointing at rig goes, never a file or a link
    # elsewhere.
    local l s
    for l in "$dir"/*; do
        [[ -L "$l" ]] || continue
        s=${l##*/}
        case "$(readlink "$l")" in rig|"$dir/rig") ;; *) continue ;; esac
        [[ " ${symlinks[*]} " == *" $s "* ]] && continue
        rm -f -- "$l"
        echo "  removed $l"
    done
}

usage(){
    cat <<EOF
rig - ripgit: git tools

  rig co [ref|pattern] Fetch + detached checkout (rco)
  rig p [branch]     Push to origin (rip)
  rig r [pattern]    Rebase -i origin (rir)
  rig m [pattern]    Merge origin (rim)
  rig install        Create symlinks

Aliases (installed as symlinks):
  gl                 git log --oneline -20
  gis                git status -uno
  gig                git log --graph --oneline --simplify-by-decoration --all --decorate
  gitg               git log --graph --oneline --all --decorate
  gp  [commit...]    git cherry-pick
  gpc                git cherry-pick --continue
  gpa                git cherry-pick --abort
  gw  [args...]      git worktree
  gif / gifs         git diff / git diff --staged
  gss / gsp / gsl     git stash / stash pop / stash list --stat
  grec / grea / gres  git rebase --continue / --abort / --skip
  gco [ref|pattern]   Detached checkout without fetch
  gco [ref] [restore-options] -- paths  Restore files with git checkout
  gib [options...] [patterns...]  List branches (--all by default; never create)
  gitsu              git status

Flags: -z offline, -n dry-run, ? force fzf
Checkout refuses -b/-B/-c/-C/--track/-t/--orphan; local refs detach.
EOF
    exit 1
}

dispatch(){
    case "$1" in
        co|checkout|rco) shift; cmd_branch_op checkout "$@" ;;
        gco)            shift; cmd_branch_op gco "$@" ;;
        p|push|rip)      shift; cmd_push "$@" ;;
        r|rebase|rir)    shift; cmd_branch_op rebase "$@" ;;
        m|merge|rim)     shift; cmd_branch_op merge "$@" ;;
        gl)   shift; git --no-pager log --oneline -20 "$@" ;;
        gis)  shift; git status -uno "$@" ;;
        gif)  shift; git diff "$@" ;;
        gifs) shift; git diff --staged "$@" ;;
        gss)  shift; git stash "$@" ;;
        gsp)  shift; git stash pop "$@" ;;
        gsl)  shift; git stash list --stat "$@" ;;
        grec) shift; git rebase --continue "$@" ;;
        grea) shift; git rebase --abort "$@" ;;
        gres) shift; git rebase --skip "$@" ;;
        gib)  shift; git branch --all "$@" --list ;;
        gitsu) shift; git status "$@" ;;
        gig)  shift; git log --graph --oneline --simplify-by-decoration --all --decorate "$@" ;;
        gitg) shift; git log --graph --oneline --all --decorate "$@" ;;
        gp)   shift; git cherry-pick "$@" ;;
        gpc)  git cherry-pick --continue ;;
        gpa)  git cherry-pick --abort ;;
        gw)   shift; git worktree "${@:-list}" ;;
        install)         cmd_install ;;
        aliases)         printf '%s\n' "${symlinks[@]}" ;;
        -h|--help|help|"") usage ;;
        *)  echo "error: unknown command: $1"; usage ;;
    esac
}

name=$(basename "$0")
if [[ "$name" != "rig" ]]; then
    dispatch "$name" "$@"
else
    dispatch "${1:-}" "${@:2}"
fi
