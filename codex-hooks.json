{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/codex_hook.py UserPromptSubmit prompt_nudge",
            "timeout": 5,
            "statusMessage": "Checking Kronael prompt nudges"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|apply_patch|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/codex_hook.py PreToolUse pretool_nudge",
            "timeout": 5,
            "statusMessage": "Checking Kronael file nudges"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/codex_hook.py PostToolUse pretool_nudge",
            "timeout": 10,
            "statusMessage": "Reflowing Kronael Markdown"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/codex_hook.py PostToolUse stop",
            "timeout": 10,
            "statusMessage": "Checking Kronael commit and diary"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/codex_hook.py Stop stop",
            "timeout": 10,
            "statusMessage": "Checking Kronael stop nudges"
          }
        ]
      }
    ]
  }
}
