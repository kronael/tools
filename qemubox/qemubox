#!/usr/bin/env bash
set -euo pipefail

# Debian "generic" (not "genericcloud"): the genericcloud kernel is trimmed and
# omits the 9p filesystem module, so `mount -t 9p` fails with "unknown filesystem
# type '9p'". The generic image ships the full module set including 9p.
BASE_URL="${QEMUBOX_BASE_URL:-https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-amd64.qcow2}"
ROOT="${QEMUBOX_HOME:-$HOME/.local/share/qemubox}"
MEM="${QEMUBOX_MEM:-4096}"
CPUS="${QEMUBOX_CPUS:-2}"
USER="${QEMUBOX_USER:-sandbox}"
QEMU="${QEMUBOX_QEMU:-qemu-system-x86_64}"

name_override=""
entrypoint="claude"
entrypoint_explicit=""
network=1
ssh_agent=""
gpg_sock=""
docker_sock=""
docker_remote=""
no_copy=""
gcloud_creds=""
gpg_forward=""
untrusted=""
booted=""
args=()
dirs=()
extra_dirs=()
extra_modes=()
envs=()
warnings=()
mount_tags=()
mount_srcs=()
mount_dests=()
mount_modes=()

# Single-file host configs copied into a per-box staging dir and 9p-mounted
# read-only at /mnt/qemubox-home. Only these leave the host -- never all of
# $HOME -- so the guest cannot read ~/.ssh, cloud creds, or other projects.
host_cfg_files=(.claude.json .gitconfig .dockbox_history .gnupg/pubring.kbx .gnupg/pubring.gpg)

usage() {
    cat <<EOF
Usage: qemubox [options] [tool] [dirs...] [tool-args...]
       qemubox ls | status <name> | rm <pattern|-a> | prune [hours] | build-base [--force]
       qemubox [options] bash [dirs...]

Tools (first positional arg -- no leading dash):
    (default)       Claude Code, opus @ xhigh effort
    claude          Claude Code, opus (same as default)
    codex           OpenAI Codex
    haiku           Claude Code --model claude-haiku-4-5-20251001
    sonnet          Claude Code --model claude-sonnet-5 --effort high
    opus            Claude Code --model claude-opus-5 --effort xhigh
    fable           Claude Code --model claude-fable-5
    gpt             Codex -m gpt-5.5
    mini            Codex -m gpt-5.4-mini
    spark           Codex -m gpt-5.3-codex-spark
    bash|zsh|sh     Interactive shell (sh is an alias)
    <any cmd>       Any binary installed in the VM

Options:
    -n name    Override VM name (default: qemubox-<project>)
    -d tool    Explicit tool (same as first-arg tool, useful in scripts)
    -x tool    Alias for -d, matching dockbox
    -e VAR     Forward env var into the SSH command
    -v path    Extra 9p mount at same path ro by default; path:rw for read-write
    -N         No project mount; run in VM home
    -H         Egress kill-switch: disable the guest's outbound network
    -U         Untrusted: inject NO host config/credentials, force network off,
               but still mount the project dir(s). --untrusted also works.
               The agent cannot authenticate here -- use it for bash/build/test.
    -A         Forward SSH agent
    -D         Forward Docker socket over SSH
    -K         Forward gpg-agent (commit signing); off by default
    -S         Accepted for dockbox parity; guest user already has sudo
    -g         Forward GH_TOKEN / GITHUB_TOKEN for this SSH command
    -G         Mount ~/.config/gcloud ro
    -P|-T      Accepted for dockbox parity; no ephemeral overmounts in qemubox

Examples:
    qemubox
    qemubox ~/src/repo
    qemubox haiku ~/src/repo
    qemubox codex ~/src/repo
    qemubox bash
    qemubox -n mybox bash
    qemubox cargo test ~/src/repo
    qemubox -H cargo test ~/src/repo
    qemubox -v ~/src/lib ~/src/repo
    qemubox ls
    qemubox rm repo

Ingress: dirs and config are mounted into the VM with QEMU 9p.
SSH is only the control channel used to enter the guest.

State: $ROOT
EOF
}

box_name() {
    printf '%s' "${1:-default}" | tr -c 'A-Za-z0-9_.-' '-'
}

box_dir() {
    printf '%s/%s' "$ROOT" "$(box_name "$1")"
}

port_for() {
    _pf_dir="$(box_dir "$1")"
    # A box persists its chosen port in $dir/port (start_box picks the first free
    # one from the name-hash, so a collision reallocates). Read it back if set.
    if [ -s "$_pf_dir/port" ]; then cat "$_pf_dir/port"; return; fi
    cksum=$(printf '%s' "$(box_name "$1")" | cksum | awk '{print $1}')
    echo $((10000 + cksum % 50000))
}

missing_deps() {
    miss=""
    for dep in "$QEMU" qemu-img cloud-localds ssh ssh-keygen curl tar flock; do
        command -v "$dep" >/dev/null 2>&1 || miss="$miss $dep"
    done
    [ -z "$miss" ] || {
        echo "Missing:$miss" >&2
        echo "Install qemubox system dependencies listed in qemubox/README.md." >&2
        exit 1
    }
}

# Script voice: qemubox's own control/status lines. A bold-cyan ">>>" prefix on
# a TTY sets these apart from raw guest output; piped/non-interactive stays the
# exact plain "qemubox: ..." text so logs and greps are unchanged.
note() {
    if [ -t 2 ]; then
        printf '\033[1;36m>>> qemubox:\033[0m %s\n' "$*" >&2
    else
        printf 'qemubox: %s\n' "$*" >&2
    fi
}

# Verify a freshly downloaded base image before it is trusted. A pinned
# QEMUBOX_BASE_SHA512 wins (offline/deterministic); otherwise check Debian's
# published SHA512SUMS beside the image. A checksum MISMATCH aborts; only an
# unreachable/missing SHA512SUMS is warn-and-proceed, so a mirror hiccup does
# not block installs.
verify_base() {
    tmp="$1"
    want="${QEMUBOX_BASE_SHA512:-}"
    if [ -z "$want" ]; then
        sums="$(curl -fsL "${BASE_URL%/*}/SHA512SUMS" 2>/dev/null || true)"
        [ -n "$sums" ] || { note "WARNING: could not fetch SHA512SUMS; skipping base checksum"; return 0; }
        want="$(printf '%s\n' "$sums" | awk -v f="${BASE_URL##*/}" '$2==f {print $1}')"
        [ -n "$want" ] || { note "WARNING: ${BASE_URL##*/} absent from SHA512SUMS; skipping checksum"; return 0; }
    fi
    note "verifying base image sha512"
    printf '%s  %s\n' "$want" "$tmp" | sha512sum -c - >/dev/null 2>&1 || {
        echo "qemubox: base image checksum MISMATCH -- refusing $tmp" >&2
        rm -f "$tmp"
        exit 1
    }
}

ensure_base() {
    mkdir -p "$ROOT/base"
    base="$ROOT/base/${BASE_URL##*/}"
    [ -s "$base" ] || {
        note "downloading base cloud image"
        note "source: $BASE_URL"
        note "why: this is the reusable Debian disk template for new VM overlays"
        curl -fL "$BASE_URL" -o "$base.tmp"
        verify_base "$base.tmp"
        mv "$base.tmp" "$base"
        note "saved base image: $base"
    }
    echo "$base"
}

ensure_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    mkdir -p "$dir"
    # Prefer the prebuilt base (packages baked in -> boxes skip first-boot apt);
    # fall back to the raw generic image so the lazy-apt path still works if it
    # was never built. build-base sets $backing_override to the raw base so it
    # never bakes on top of an existing prebuilt base.
    provisioned="$ROOT/base/provisioned.qcow2"
    if [ -n "${backing_override:-}" ]; then
        base="$backing_override"
    elif [ -s "$provisioned" ]; then
        base="$provisioned"
    else
        base="$(ensure_base)"
    fi
    [ -f "$dir/key" ] || {
        note "creating SSH key for qemubox-$name"
        note "why: cloud-init uses this key so the host can enter the guest"
        ssh-keygen -t ed25519 -f "$dir/key" -N "" -C "qemubox-$name" >/dev/null
    }
    [ -f "$dir/seed.iso" ] || {
        note "creating cloud-init seed for qemubox-$name"
        note "why: it creates the sandbox user and installs the SSH key on first boot"
        pub="$(cat "$dir/key.pub")"
        {
            echo "#cloud-config"
            echo "users:"
            echo "  - name: $USER"
            echo "    sudo: ALL=(ALL) NOPASSWD:ALL"
            echo "    groups: sudo"
            echo "    shell: /bin/bash"
            echo "    ssh_authorized_keys:"
            echo "      - $pub"
            echo "ssh_pwauth: false"
        } > "$dir/user-data"
        echo "instance-id: qemubox-$name" > "$dir/meta-data"
        cloud-localds "$dir/seed.iso" "$dir/user-data" "$dir/meta-data"
    }
    [ -f "$dir/disk.qcow2" ] || {
        note "creating disposable qcow2 overlay for qemubox-$name"
        note "why: VM writes go to this overlay, not the cached base image"
        qemu-img create -f qcow2 -F qcow2 -b "$base" "$dir/disk.qcow2" >/dev/null
    }
}

running() {
    dir="$(box_dir "$1")"
    [ -s "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null
}

ssh_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    shift
    agent=()
    [ -n "$ssh_agent" ] && agent=(-A)
    gpg=()
    [ -n "$gpg_sock" ] && gpg=(-o StreamLocalBindUnlink=yes -R "/home/$USER/.gnupg/S.gpg-agent:$gpg_sock")
    docker=()
    [ -n "$docker_sock" ] && docker=(-R "$docker_remote:$docker_sock")
    ssh -i "$dir/key" -p "$(port_for "$name")" \
        "${agent[@]}" \
        "${gpg[@]}" \
        "${docker[@]}" \
        -o UserKnownHostsFile="$dir/known_hosts" \
        -o StrictHostKeyChecking=accept-new \
        "$USER@127.0.0.1" "$@"
}

ssh_plain_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    shift
    ssh -i "$dir/key" -p "$(port_for "$name")" \
        -o UserKnownHostsFile="$dir/known_hosts" \
        -o StrictHostKeyChecking=accept-new \
        "$USER@127.0.0.1" "$@"
}

# Guest voice: run a guest command and stream its output behind a dim gutter so
# it reads as "inside the VM". ONLY for standalone, human-facing calls whose
# output is neither captured nor used for control flow -- the gutter pipe plus
# `pipefail` would corrupt the exit status of those. Off a TTY it is exactly
# ssh_plain_box (no pipe), so behavior and output stay byte-for-byte unchanged.
ssh_stream_box() {
    if [ -t 2 ]; then
        ssh_plain_box "$@" 2>&1 | sed $'s/^/\033[2m> \033[0m/' >&2
    else
        ssh_plain_box "$@"
    fi
}

quote() {
    printf "%q" "$1"
}

add_mount() {
    src="$1"
    dest="$2"
    mode="$3"
    [ -e "$src" ] || return 0
    case "$src" in
        *,*) echo "Cannot 9p-mount path containing comma: $src" >&2; exit 2 ;;
    esac
    tag="qbx${#mount_tags[@]}"
    mount_tags+=("$tag")
    mount_srcs+=("$src")
    mount_dests+=("$dest")
    mount_modes+=("$mode")
}

stage_host_cfg() {
    cfg="$1"
    mkdir -p "$cfg/.gnupg"
    chmod 700 "$cfg"
    for rel in "${host_cfg_files[@]}"; do
        if [ -f "$HOME/$rel" ]; then
            cp -pL "$HOME/$rel" "$cfg/$rel"
        else
            rm -f "$cfg/$rel"
        fi
    done
}

qemu_mount_args() {
    for i in "${!mount_tags[@]}"; do
        ro=""
        [ "${mount_modes[$i]}" = ro ] && ro=",readonly=on"
        printf '%s\n' -virtfs
        printf 'local,path=%s,mount_tag=%s,security_model=none%s\n' \
            "${mount_srcs[$i]}" "${mount_tags[$i]}" "$ro"
    done
}

start_box() {
    name="$(box_name "$1")"
    missing_deps
    dir="$(box_dir "$name")"
    mkdir -p "$dir"
    port="$(port_for "$name")"
    # Serialize concurrent same-name launches so two invocations don't both
    # ssh-keygen / qemu-img / boot a second qemu on one disk and port. Held only
    # through boot; released before the long-lived interactive session.
    exec 9>"$dir/.lock"
    flock 9
    ensure_box "$name"
    running "$name" && {
        note "reusing running VM qemubox-$name on 127.0.0.1:$port"
        booted=""
        flock -u 9
        return
    }
    # Fresh boot: from the name-hash port, walk up to the first free one and
    # persist it to $dir/port, so re-entry and ssh reuse the same port and a
    # name-hash collision with another box reallocates instead of failing.
    if [ ! -s "$dir/port" ]; then
        for _ in $(seq 1 100); do
            (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || break
            port=$(( (port - 10000 + 1) % 50000 + 10000 ))
        done
        echo "$port" > "$dir/port"
    fi
    accel=()
    [ -e /dev/kvm ] && accel=(-enable-kvm)
    restrict=",restrict=on"
    [ -n "$network" ] && restrict=""
    if [ "${#accel[@]}" -gt 0 ]; then
        note "starting qemubox-$name with KVM acceleration"
    else
        note "starting qemubox-$name without KVM; software emulation is slower"
    fi
    if [ -n "$network" ]; then
        note "guest network: outbound enabled"
    else
        note "guest network: restricted; only host SSH forwarding is open"
    fi
    mapfile -t mounts < <(qemu_mount_args)
    "$QEMU" "${accel[@]}" \
        -m "$MEM" -smp "$CPUS" \
        -drive "file=$dir/disk.qcow2,if=virtio,format=qcow2" \
        -drive "file=$dir/seed.iso,media=cdrom,readonly=on" \
        "${mounts[@]}" \
        -nic "user,model=virtio$restrict,hostfwd=tcp:127.0.0.1:$port-:22" \
        -serial "file:$dir/serial.log" \
        -display none -daemonize -pidfile "$dir/pid"
    note "waiting for SSH on 127.0.0.1:$port"
    note "why: cloud-init must finish user/key setup before commands can run"
    for i in $(seq 1 90); do
        ssh_plain_box "$name" true >/dev/null 2>&1 && { booted=1; flock -u 9; return; }
        [ $((i % 10)) -eq 0 ] && note "still waiting for SSH; serial log: $dir/serial.log"
        sleep 2
    done
    # SSH never came up: kill the daemonized qemu so a boot that never reached
    # SSH isn't orphaned holding RAM/CPU and the rw 9p mounts.
    pid="$(cat "$dir/pid" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    rm -f "$dir/pid"
    echo "SSH not ready; see $dir/serial.log" >&2
    exit 1
}

detect_gpg() {
    gpg_sock="$(gpgconf --list-dirs agent-socket 2>/dev/null || true)"
    [ -S "$gpg_sock" ] || gpg_sock=""
}

setup_guest_auth() {
    name="$1"
    ssh_plain_box "$name" "mkdir -p ~/.gnupg && chmod 700 ~/.gnupg"
    if [ -n "$gpg_sock" ]; then
        note "forwarding gpg-agent into qemubox-$name over SSH"
        note "why: this mirrors dockbox's gpg-agent socket mount without sharing a host filesystem"
    fi
}

mount_host_paths() {
    name="$1"
    note "mounting host paths into qemubox-$name with 9p"
    note "why: qemubox mirrors dockbox access patterns without copying files"
    # 9p fs + virtio transport are kernel modules; load them, then verify the
    # guest kernel actually provides 9p before mounting. A trimmed "cloud" kernel
    # omits it entirely (no modprobe can help) — fail loud with the fix instead of
    # a cryptic "unknown filesystem type '9p'".
    ssh_plain_box "$name" 'sudo modprobe 9p 9pnet_virtio 2>/dev/null || true'
    ssh_plain_box "$name" 'grep -qw 9p /proc/filesystems' || {
        note "guest kernel lacks 9p filesystem support."
        note "use a full-kernel base image (Debian 'generic', not 'genericcloud')"
        note "then rebuild: qemubox rm $name"
        exit 1
    }
    for i in "${!mount_tags[@]}"; do
        tag="${mount_tags[$i]}"
        dest="${mount_dests[$i]}"
        opts="trans=virtio,version=9p2000.L,msize=104857600"
        [ "${mount_modes[$i]}" = ro ] && opts="$opts,ro"
        ssh_plain_box "$name" "sudo mkdir -p $(quote "$dest")"
        ssh_plain_box "$name" "mountpoint -q $(quote "$dest") || sudo mount -t 9p -o $(quote "$opts") $(quote "$tag") $(quote "$dest")"
    done
}

provision_guest_packages() {
    name="$1"
    marker="/var/lib/qemubox/packages-v1"
    if ! ssh_plain_box "$name" "[ -f $marker ]" >/dev/null 2>&1; then
        note "installing guest base packages in qemubox-$name"
        note "why: qemubox needs the same practical shell/git/gpg/runtime layer as dockbox"
        ssh_stream_box "$name" 'sudo mkdir -p /var/lib/qemubox
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update
sudo apt-get install -y --no-install-recommends \
  ca-certificates curl tar xz-utils make \
  less git procps sudo fzf zsh man-db unzip zip \
  openssh-client gnupg2 jq bc nano vim \
  iproute2 dnsutils pkg-config libssl-dev libudev-dev \
  bubblewrap socat
sudo touch /var/lib/qemubox/packages-v1'
    fi
    if [ -n "$docker_sock" ]; then
        note "installing Docker CLI in qemubox-$name for -D"
        ssh_stream_box "$name" 'command -v docker >/dev/null 2>&1 || \
sudo apt-get install -y --no-install-recommends docker.io'
    fi
}

setup_guest_runtime() {
    name="$1"
    note "provisioning qemubox-$name guest wrappers"
    note "why: claude/codex run from the host-mounted /opt/dev-tools tree"
    ssh_stream_box "$name" 'sudo mkdir -p /usr/local/bin; mkdir -p ~/.gnupg && chmod 700 ~/.gnupg'
    ssh_stream_box "$name" 'node_bin=$(ls -d /opt/dev-tools/nvm/versions/node/*/bin 2>/dev/null | sort | tail -1 || true)
if [ -n "$node_bin" ]; then
  sudo ln -sf "$node_bin/node" /usr/local/bin/node
  sudo ln -sf "$node_bin/npm" /usr/local/bin/npm
  sudo ln -sf "$node_bin/npx" /usr/local/bin/npx
fi
sudo ln -sf /opt/dev-tools/bun/bin/bun /usr/local/bin/bun
sudo tee /usr/local/bin/claude >/dev/null <<'\''EOF'\''
#!/bin/sh
exec /opt/dev-tools/bun/bin/claude --dangerously-skip-permissions "$@"
EOF
sudo tee /usr/local/bin/codex >/dev/null <<'\''EOF'\''
#!/bin/sh
exec /opt/dev-tools/bun/bin/codex --dangerously-bypass-approvals-and-sandbox "$@"
EOF
sudo chmod 755 /usr/local/bin/claude /usr/local/bin/codex'
    ssh_stream_box "$name" 'mkdir -p ~/.docker/run'
    note "copying agent config into qemubox-$name (writable guest copy; host stays read-only)"
    ssh_stream_box "$name" 'for d in .claude .codex .agents; do
  s="/mnt/qemubox-cfg/$d"; [ -d "$s" ] || continue
  sudo mkdir -p ~/"$d"; sudo chown "$(id -u):$(id -g)" ~/"$d"
  ( cd "$s" && tar -cpf - --exclude=./projects --exclude=./todos --exclude=./sessions --exclude="./*.sqlite*" --exclude=./log --exclude=./cache --exclude=./.cache --exclude=./.tmp --exclude=./history.jsonl --exclude=./statsig --exclude=./file-history --exclude=./shell_snapshots --exclude=./shell-snapshots . ) | tar -C ~/"$d" -xpf -
done'
    ssh_stream_box "$name" '[ -e /mnt/qemubox-home/.claude.json ] && ln -sf /mnt/qemubox-home/.claude.json ~/.claude.json || true
[ -e /mnt/qemubox-home/.gitconfig ] && ln -sf /mnt/qemubox-home/.gitconfig ~/.gitconfig || true
[ -e /mnt/qemubox-home/.dockbox_history ] && ln -sf /mnt/qemubox-home/.dockbox_history ~/.bash_history || true
[ -e /mnt/qemubox-home/.gnupg/pubring.kbx ] && ln -sf /mnt/qemubox-home/.gnupg/pubring.kbx ~/.gnupg/pubring.kbx || true
[ -e /mnt/qemubox-home/.gnupg/pubring.gpg ] && ln -sf /mnt/qemubox-home/.gnupg/pubring.gpg ~/.gnupg/pubring.gpg || true'
}

stop_box() {
    name="$(box_name "$1")"
    running "$name" || return 0
    dir="$(box_dir "$name")"
    pid="$(cat "$dir/pid")"
    ssh_box "$name" sudo poweroff >/dev/null 2>&1 || true
    # Wait for a clean guest shutdown (systemd can take ~90s), then escalate
    # SIGTERM -> SIGKILL so a wedged VM is terminated, never left as an orphaned
    # qemu whose disk remove_box is about to unlink.
    for _ in $(seq 1 90); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    for _ in $(seq 1 5); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    if kill -0 "$pid" 2>/dev/null; then
        echo "VM still running as PID $pid" >&2
        return 1
    fi
    rm -f "$dir/pid"
}

remove_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    # Never delete a box's disk/keys while its VM is still alive -- stop_box now
    # escalates to SIGKILL, so a failure here means it genuinely could not die.
    stop_box "$name" || { echo "qemubox-$name still running; not removing its files" >&2; return 1; }
    rm -f "$dir/disk.qcow2" "$dir/seed.iso" "$dir/user-data" "$dir/meta-data"
    rm -f "$dir/serial.log" "$dir/pid" "$dir/known_hosts" "$dir/key" "$dir/key.pub" "$dir/.lock" "$dir/port"
    for rel in "${host_cfg_files[@]}"; do rm -f "$dir/hostcfg/$rel"; done
    rmdir "$dir/hostcfg/.gnupg" "$dir/hostcfg" 2>/dev/null || true
    rmdir "$dir" 2>/dev/null || true
    echo "removed qemubox-$name"
}

# Bake the apt package layer once into a reusable base image so new boxes skip
# first-boot apt. Rides the same ensure_box/start_box/ssh/provision paths as a
# normal box -- just a throwaway box in a hidden dir ($ROOT/.build, so ls/rm/prune
# never see it) with no host mounts. Idempotent: skips if the base already exists
# unless a rebuild is forced.
build_base() {
    force="${1:-}"
    missing_deps
    provisioned="$ROOT/base/provisioned.qcow2"
    if [ -s "$provisioned" ] && [ -z "$force" ]; then
        note "prebuilt base already present: $provisioned"
        note "why: new boxes boot from it and skip apt; pass --force to rebuild"
        return 0
    fi
    # Force the raw generic image as the build overlay's backing so we never bake
    # on top of an existing prebuilt base; the flattened result replaces it below.
    backing_override="$(ensure_base)"
    name=".build"
    dir="$(box_dir "$name")"
    remove_box "$name" >/dev/null 2>&1 || true
    note "building prebuilt base image in a throwaway box"
    note "why: bake the apt layer once so every new box boots in seconds"
    start_box "$name"
    provision_guest_packages "$name"
    note "cleaning cloud-init state so boxes built from this base re-run it fresh"
    ssh_plain_box "$name" 'sudo cloud-init clean --logs --seed'
    note "dropping the throwaway build key and powering off"
    # Once the key is gone SSH cannot reconnect, so the power-off must ride the
    # same connection; the dropped connection at poweroff is expected.
    ssh_plain_box "$name" 'rm -f ~/.ssh/authorized_keys; sudo poweroff' >/dev/null 2>&1 || true
    stop_box "$name"
    note "flattening build overlay into a standalone base: $provisioned"
    note "why: convert (not commit) leaves the pristine generic image untouched"
    qemu-img convert -O qcow2 "$dir/disk.qcow2" "$provisioned.tmp"
    mv "$provisioned.tmp" "$provisioned"
    remove_box "$name" >/dev/null 2>&1 || true
    note "prebuilt base ready; new boxes skip first-boot apt"
}

list_boxes() {
    mkdir -p "$ROOT"
    found=""
    for dir in "$ROOT"/*; do
        [ -d "$dir" ] || continue
        [ "${dir##*/}" = base ] && continue
        [ -n "$found" ] || printf "NAME\tSTATUS\tSSH\tPATH\n"
        found=1
        name="${dir##*/}"
        state=stopped
        running "$name" && state=running
        printf "qemubox-%s\t%s\t127.0.0.1:%s\t%s\n" \
            "$name" "$state" "$(port_for "$name")" "$dir"
    done
    [ -n "$found" ] || echo "no qemubox VMs"
}

# Report a box's readiness from the pidfile / serial log / SSH port only -- no
# shell into the guest -- so a wedged VM (process up, SSH dead) is distinguishable
# from a healthy one, which plain "running" in ls cannot show.
status_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    [ -d "$dir" ] || { echo "no qemubox VM named '$name'" >&2; exit 1; }
    port="$(port_for "$name")"
    proc=stopped; running "$name" && proc=running
    ssh_state=closed
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && ssh_state=open
    boot=pending
    [ -f "$dir/serial.log" ] && grep -qiE 'cloud-init.*(finished|done)|login:' "$dir/serial.log" && boot=ready
    printf "qemubox-%s\tprocess=%s\tssh=%s\tboot=%s\tport=%s\n" \
        "$name" "$proc" "$ssh_state" "$boot" "$port"
    # 9p mounts are set up post-boot over SSH, not at boot, so they never appear
    # in the serial log; enter the box (qemubox bash) to inspect them.
}

add_env() {
    var="$1"
    case "$var" in
        ""|*[!A-Za-z0-9_]*|[0-9]*)
            echo "Invalid env var: $var" >&2
            exit 2 ;;
    esac
    val="${!var-}"
    envs+=("$var=$val")
}

copy_arg() {
    # Strip only a trailing mode suffix so paths that themselves contain a colon
    # survive (the mode is parsed from the full arg by the caller).
    path="$1"
    case "$path" in
        *:rw) path="${path%:rw}" ;;
        *:ro) path="${path%:ro}" ;;
    esac
    case "$path" in
        /*|./*|.|~*) printf '%s' "$path" ;;
        *) echo "Invalid -v path: $1" >&2; exit 2 ;;
    esac
}

apply_flag() {
    case "$1" in
        n)
            # box_name keeps '.', so reject traversal/reserved names here in the
            # main shell (apply_flag runs un-subshelled) where exit stops the run.
            case "$2" in
                ""|.|..|base|.build|*/*)
                    echo "qemubox: invalid -n name: '$2'" >&2; exit 2 ;;
            esac
            name_override="$2" ;;
        d|x) entrypoint="$2"; entrypoint_explicit=1 ;;
        e) add_env "$2" ;;
        v)
            extra_dirs+=("$(copy_arg "$2")")
            case "$2" in
                *:rw) extra_modes+=(rw) ;;
                *) extra_modes+=(ro) ;;
            esac ;;
        N) no_copy=1 ;;
        H) network="" ;;
        U) untrusted=1; network="" ;;
        A) ssh_agent=1 ;;
        D)
            if [ -S /var/run/docker.sock ]; then
                docker_sock=/var/run/docker.sock
                docker_remote="/home/$USER/.docker/run/docker.sock"
                envs+=("DOCKER_HOST=unix://$docker_remote")
            else
                warnings+=("-D ignored: /var/run/docker.sock is not available")
            fi ;;
        K) gpg_forward=1 ;;
        S) warnings+=("-S ignored: qemubox guest user already has passwordless sudo") ;;
        P|T) warnings+=("-$1 ignored: qemubox copies dirs instead of overmounting build dirs") ;;
        g)
            [ -n "${GH_TOKEN:-}" ] && envs+=("GH_TOKEN=$GH_TOKEN")
            [ -n "${GITHUB_TOKEN:-}" ] && envs+=("GITHUB_TOKEN=$GITHUB_TOKEN") ;;
        G) gcloud_creds=1 ;;
        *) usage >&2; exit 2 ;;
    esac
    return 0  # never let a falsey last branch (e.g. -g with no token) trip set -e
}

tool_cmd() {
    case "$1" in
        claude) cmd=(claude --model claude-opus-4-8 --effort xhigh) ;;
        codex) cmd=(codex) ;;
        haiku) cmd=(claude --model claude-haiku-4-5-20251001) ;;
        sonnet) cmd=(claude --model claude-sonnet-5 --effort high) ;;
        opus) cmd=(claude --model claude-opus-5 --effort xhigh) ;;
        fable) cmd=(claude --model claude-fable-5) ;;
        gpt) cmd=(codex -m gpt-5.5) ;;
        mini) cmd=(codex -m gpt-5.4-mini) ;;
        spark) cmd=(codex -m gpt-5.3-codex-spark) ;;
        sh|bash) cmd=(bash -l) ;;
        zsh) cmd=(zsh -l) ;;
        *) cmd=("$1") ;;
    esac
}

# Decide whether box $1 matches the user's rm pattern $2. Empty pattern -> all;
# a pattern containing * or ? is a glob, otherwise an exact name match.
rm_matches() {
    _n="$1"; _pat="$2"
    [ -z "$_pat" ] && return 1  # empty never matches; the caller requires a pattern (use '*' for all)
    case "$_pat" in
        *[*?]*) case "$_n" in $_pat) return 0 ;; *) return 1 ;; esac ;;
        *) [ "$_n" = "$_pat" ] ;;
    esac
}

# -U injects nothing: neutralize every credential-forwarding flag before mounts
# and forwards are assembled. assemble_mounts already skips the config mounts
# under $untrusted; this also drops -A/-D/-K/-G/-g so they cannot smuggle a live
# credential into an "untrusted" box. Operates on the parsing globals.
apply_untrusted() {
    dropped=""
    [ -n "$ssh_agent$docker_sock$gpg_forward$gcloud_creds" ] && dropped=1
    ssh_agent=""; docker_sock=""; docker_remote=""; gpg_forward=""; gcloud_creds=""
    kept=()
    for e in "${envs[@]}"; do
        case "$e" in GH_TOKEN=*|GITHUB_TOKEN=*|DOCKER_HOST=*) dropped=1 ;; *) kept+=("$e") ;; esac
    done
    envs=("${kept[@]}")
    [ -n "$dropped" ] && warnings+=("-U: dropping credential-forwarding flags (-A/-D/-K/-G/-g); untrusted mode injects nothing")
    case "${entrypoint:-}" in
        claude|codex|haiku|sonnet|opus|fable|gpt|mini|spark)
            warnings+=("-U: no credentials injected; the agent cannot authenticate -- use bash/build/test") ;;
    esac
}

# Build the 9p mount list (mount_* arrays) for the resolved flag set. Reads the
# globals set during argument parsing; called once from the main flow.
assemble_mounts() {
    add_mount "/opt/dev-tools" "/opt/dev-tools" ro
    add_mount "/usr/local/share/npm-global" "/usr/local/share/npm-global" ro
    add_mount "/opt/playwright-browsers" "/opt/playwright-browsers" ro
    # Untrusted mode injects no host config or credentials: skip the single-file
    # staging mount, the agent-config mounts, and the per-slug memory mount below.
    # Only the project dir(s) and tool binaries above cross in.
    if [ -z "$untrusted" ]; then
        host_cfg="$(box_dir "$name")/hostcfg"
        stage_host_cfg "$host_cfg"
        add_mount "$host_cfg" "/mnt/qemubox-home" ro
        # Agent config: mounted read-only at a staging path, then copied into the
        # guest's own writable home (setup_guest_runtime). Guest writes to config never
        # reach the host, and the guest sees config at the normal paths so tools find it.
        for d in .claude .codex .agents; do
            add_mount "$HOME/$d" "/mnt/qemubox-cfg/$d" ro
        done
    fi
    # Session data for THIS project persists to the host (transcripts + auto-memory),
    # scoped to the active project's slug so the guest never sees or writes any other
    # project's history. Everything else stays inside the disposable VM.
    if [ -z "${no_copy:-}" ] && [ -d "$HOME/.claude" ] && [ -z "$untrusted" ]; then
        slug="${primary//\//-}"
        mkdir -p "$HOME/.claude/projects/$slug"
        add_mount "$HOME/.claude/projects/$slug" "/home/$USER/.claude/projects/$slug" rw
    fi
    [ -n "$gcloud_creds" ] && add_mount "$HOME/.config/gcloud" "/home/$USER/.config/gcloud" ro
    if [ -z "${no_copy:-}" ]; then
        for dir in "${dirs[@]}"; do
            add_mount "$dir" "$dir" rw
        done
    fi
    for i in "${!extra_dirs[@]}"; do
        dir="$(cd "${extra_dirs[$i]}" && pwd)"
        add_mount "$dir" "$dir" "${extra_modes[$i]}"
    done
    return 0
}

# Sourcing with QEMUBOX_LIB=1 loads the helpers above without running the CLI,
# so tests can exercise them directly.
[ -n "${QEMUBOX_LIB:-}" ] && return 0

case "${1:-}" in
    ls) list_boxes; exit 0 ;;
    status)
        [ -n "${2:-}" ] || { echo "usage: qemubox status <name>" >&2; exit 2; }
        status_box "$2"; exit 0 ;;
    rm|destroy)
        pat="${2:-}"
        [ -z "$pat" ] && { echo "qemubox rm: a name or glob is required (-a / '*' removes all)" >&2; exit 2; }
        case "$pat" in -a|--all) pat='*' ;; esac
        found=""
        for dir in "$ROOT"/*; do
            [ -d "$dir" ] || continue
            name="${dir##*/}"
            [ "$name" = base ] && continue
            rm_matches "$name" "$pat" || continue
            found=1
            remove_box "$name" || true
        done
        if [ -z "$found" ]; then
            if [ -n "$pat" ]; then
                echo "no match for '$pat'"
            else
                echo "no qemubox VMs"
            fi
        fi
        exit 0 ;;
    prune)
        hours="${2:-2160}"
        cutoff=$(date -d "-$hours hours" +%s 2>/dev/null) || cutoff=$(date -v-"$hours"H +%s)
        for dir in "$ROOT"/*; do
            [ -d "$dir" ] || continue
            name="${dir##*/}"
            [ "$name" = base ] && continue
            running "$name" && continue
            # A dir vanishing between the glob and here (concurrent rm/prune)
            # must skip, not trip set -e and abort the whole prune.
            ts=$(stat -c %Y "$dir" 2>/dev/null || stat -f %m "$dir" 2>/dev/null) || continue
            [ "$ts" -lt "$cutoff" ] && remove_box "$name" || true
        done
        exit 0 ;;
    build-base)
        force=""
        case "${2:-}" in
            ""|--force|-f|rebuild) [ -n "${2:-}" ] && force=1 ;;
            *) echo "unknown build-base option: $2" >&2; exit 2 ;;
        esac
        build_base "$force"
        exit 0 ;;
    -h|--help|help) usage; exit 0 ;;
esac

_args=()
for a in "$@"; do
    case "$a" in
        --no-ephemeral) warnings+=("--no-ephemeral ignored: qemubox has no ephemeral overmounts") ;;
        --untrusted) untrusted=1; network="" ;;
        *) _args+=("$a") ;;
    esac
done
set -- "${_args[@]}"

while getopts ":n:d:x:e:v:HKUADgGPTSN" opt; do
    apply_flag "$opt" "${OPTARG:-}"
done
shift $((OPTIND - 1))

if [ -z "$entrypoint_explicit" ] && [ "$#" -gt 0 ]; then
    case "$1" in
        /*|./*|.|~*) : ;;
        *) entrypoint="$1"; shift ;;
    esac
fi

tool_cmd "$entrypoint"

for arg in "$@"; do
    case "$arg" in
        /*|./*|.|~*) dirs+=("$(cd "$arg" && pwd)") ;;
        *) args+=("$arg") ;;
    esac
done

[ "${#dirs[@]}" -gt 0 ] || dirs=("$(pwd)")
primary="${dirs[-1]}"
name="$(box_name "${name_override:-${primary##*/}}")"

[ -n "$untrusted" ] && apply_untrusted

assemble_mounts

[ -n "$gpg_forward" ] && detect_gpg
start_box "$name"
# Drop this session's ref-count marker BEFORE provisioning, so a sibling session
# exiting mid-setup cannot see left=0 and tear the VM down under us.
sid="$$"
ssh_plain_box "$name" "sudo mkdir -p /run/qemubox/sess && sudo touch /run/qemubox/sess/$sid" >/dev/null 2>&1 || true
# A running box's 9p device set is fixed at boot, so re-provisioning it with a
# different mount set fails hard; skip it on re-entry (matches dockbox), where
# mount/-v/dir changes don't apply. The tool/model still applies to the session.
# $booted is set from inside start_box's flock (1 = we just booted; "" = reused),
# so this is race-free against a concurrent first launch of the same box.
if [ -n "$booted" ]; then
    mount_host_paths "$name"
    provision_guest_packages "$name"
    setup_guest_runtime "$name"
    setup_guest_auth "$name"
else
    note "re-entering running qemubox-$name; mount/-v/dir changes are ignored (use -n <name> for a separate box)"
fi

for warning in "${warnings[@]}"; do
    note "$warning"
done

workdir=""
if [ -z "${no_copy:-}" ]; then
    workdir="$primary"
fi

remote=""
for arg in "${envs[@]}" "${cmd[@]}" "${args[@]}"; do
    printf -v q "%q" "$arg"
    remote="$remote $q"
done

# Ref-counted session lifecycle (mirrors dockbox): the marker was dropped right
# after start_box; run the session, then remove the marker and count what's left.
# When the last session exits, tear the disposable VM down so none is left idle;
# concurrent sessions each hold a marker and keep it up until all have exited.
rc=0
if [ -n "$workdir" ]; then
    note "running in qemubox-$name:$workdir"
    ssh_box "$name" -t "cd $(quote "$workdir") && exec env$remote" || rc=$?
else
    note "running in qemubox-$name home"
    ssh_box "$name" -t "exec env$remote" || rc=$?
fi
# Only tear down when the remaining-session count SUCCEEDS and is zero. An ssh
# hiccup while counting leaves $left empty -> keep the VM up (a sibling may still
# hold it); prune reaps a genuinely idle box later. Never teardown on error.
left="$(ssh_plain_box "$name" "sudo rm -f /run/qemubox/sess/$sid; ls /run/qemubox/sess 2>/dev/null | wc -l" 2>/dev/null)" || left=""
if [ -n "$left" ] && [ "$left" -eq 0 ]; then
    note "last session exited -- shutting down qemubox-$name"
    remove_box "$name" >/dev/null || true
fi
exit "$rc"
