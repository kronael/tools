#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${QEMUBOX_HOME:-$HOME/.local/share/qemubox}"
MEM="${QEMUBOX_MEM:-16384}"
CPUS="${QEMUBOX_CPUS:-4}"
DISK="${QEMUBOX_DISK:-40G}"
GUEST_USER="$(id -un)"
GUEST_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
QEMU="${QEMUBOX_QEMU:-qemu-system-x86_64}"
EPHEMERAL_DIRS=(node_modules .next .turbo .cache)

name_override=""
entrypoint="claude"
entrypoint_explicit=""
network=1
ssh_agent=""
gpg_sock=""
docker_sock=""
docker_remote=""
no_copy=""
persist_builds=""
eph_no_tmpfs=""
gcloud_creds=""
gpg_forward=""
untrusted=""
booted=""
args=()
dirs=()
extra_dirs=()
extra_modes=()
envs=()
warnings=()
mount_tags=()
mount_srcs=()
mount_dests=()
mount_modes=()

host_cfg_files=(.claude.json .gitconfig .gnupg/pubring.kbx .gnupg/pubring.gpg)

usage() {
    cat <<EOF
Usage: qemubox [options] [tool] [dirs...] [tool-args...]
       qemubox ls | status <name> | rm <pattern|-a> | prune [hours] | build-base [--force]
       qemubox [options] bash [dirs...]
       qemubox [options] exec <cmd> [args...]

Tools (first positional arg -- no leading dash):
    (default)       Claude Code, opus @ xhigh effort
    claude          Claude Code, opus (same as default)
    codex           OpenAI Codex
    haiku           Claude Code --model claude-haiku-4-5-20251001
    sonnet          Claude Code --model claude-sonnet-5-5 --effort high
    opus            Claude Code --model claude-opus-5-5 --effort xhigh
    fable           Claude Code --model claude-fable-5-1
    gpt             Codex -m gpt-6-astra
    mini            Codex -m gpt-5.4-mini
    spark           Codex -m gpt-5.3-codex-spark
    bash|zsh|sh     Interactive login shell (sh is an alias for bash)
    exec <cmd>      Run <cmd> in the box, every later arg passed through
    <any cmd>       Any binary installed in the VM

Options:
    -n name    Override VM name (default: qemubox-<project>)
    -d tool    Explicit tool (same as first-arg tool, useful in scripts)
    -x tool    Alias for -d, matching dockbox
    -e VAR     Forward env var into the SSH command
    -v path    Extra 9p mount at same path ro by default; path:rw for read-write
    -N         No project mount; run in VM home
    -H         Egress kill-switch: disable the guest's outbound network
    -U         Untrusted: inject NO host config/credentials, force network off,
               but still mount the project dir(s). --untrusted also works.
               The agent cannot authenticate here -- use it for bash/build/test.
    -A         Forward SSH agent
    -D         Forward Docker socket over SSH
    -K         Forward gpg-agent (commit signing); off by default
    -S         Accepted for dockbox parity; guest user already has sudo
    -g         Forward GH_TOKEN / GITHUB_TOKEN for this SSH command
    -G         Mount ~/.config/gcloud ro
    -P         Keep project build dirs on the host (--no-ephemeral)
    -T         Put build-dir overmounts on guest disk; /tmp stays tmpfs

Examples:
    qemubox
    qemubox ~/src/repo
    qemubox haiku ~/src/repo
    qemubox codex ~/src/repo
    qemubox bash
    qemubox -n mybox bash
    qemubox cargo test ~/src/repo
    qemubox -H cargo test ~/src/repo
    qemubox -v ~/src/lib ~/src/repo
    qemubox ls
    qemubox rm repo

Ingress: dirs and config are mounted into the VM with QEMU 9p.
SSH is only the control channel used to enter the guest.

Environment: QEMUBOX_MEM=16384 QEMUBOX_CPUS=4 QEMUBOX_DISK=40G
Build: QEMUBOX_SOURCE=<tools repo> QEMUBOX_DOCKER="docker"
State: $ROOT
EOF
}

box_name() {
    printf '%s' "${1:-default}" | tr -c 'A-Za-z0-9_.-' '-'
}

box_dir() {
    printf '%s/%s' "$ROOT" "$(box_name "$1")"
}

port_for() {
    _pf_dir="$(box_dir "$1")"
    # A box persists its chosen port in $dir/port (start_box picks the first free
    # one from the name-hash, so a collision reallocates). Read it back if set.
    if [ -s "$_pf_dir/port" ]; then cat "$_pf_dir/port"; return; fi
    cksum=$(printf '%s' "$(box_name "$1")" | cksum | awk '{print $1}')
    echo $((10000 + cksum % 50000))
}

missing_deps() {
    miss=""
    for dep in "$QEMU" qemu-img ssh ssh-keygen tar flock; do
        command -v "$dep" >/dev/null 2>&1 || miss="$miss $dep"
    done
    [ -z "$miss" ] || {
        echo "Missing:$miss" >&2
        echo "Install qemubox system dependencies listed in qemubox/README.md." >&2
        exit 1
    }
}

# Script voice: qemubox's own control/status lines. A bold-cyan ">>>" prefix on
# a TTY sets these apart from raw guest output; piped/non-interactive stays the
# exact plain "qemubox: ..." text so logs and greps are unchanged.
note() {
    if [ -t 2 ]; then
        printf '\033[1;36m>>> qemubox:\033[0m %s\n' "$*" >&2
    else
        printf 'qemubox: %s\n' "$*" >&2
    fi
}

ensure_base() {
    if [ ! -s "$ROOT/base/current" ]
    then
        build_base >&2
    fi
    image_id=$(cat "$ROOT/base/current")
    printf '%s/%s.qcow2\n' "$ROOT/base" "$image_id"
}

ensure_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    mkdir -p "$dir"
    if [ -f "$dir/image-id" ]
    then
        image_id=$(cat "$dir/image-id")
        base="$ROOT/base/$image_id.qcow2"
    else
        base="$(ensure_base)"
        image_id=${base##*/}
        image_id=${image_id%.qcow2}
    fi
    for file in "$base" "$ROOT/base/$image_id.vmlinuz" "$ROOT/base/$image_id.initrd"
    do
        [ -s "$file" ] || {
            echo "Missing base file $file; run qemubox rm $name, then qemubox build-base" >&2
            exit 1
        }
    done
    [ -f "$dir/key" ] || {
        note "creating SSH key for qemubox-$name"
        ssh-keygen -t ed25519 -f "$dir/key" -N "" -C "qemubox-$name" >/dev/null
    }
    mkdir -p "$dir/config"
    chmod 700 "$dir/config"
    {
        printf '%s\n' "$GUEST_USER" "$(id -u)" "$(id -g)" "$GUEST_HOME"
        for gid in $(id -G)
        do
            gname=$(getent group "$gid" | cut -d: -f1)
            printf '%s:%s ' "$gid" "$gname"
        done
        printf '\n'
    } > "$dir/config/identity"
    cp "$dir/key.pub" "$dir/config/authorized_keys"
    stage_ephemeral "$dir/config/ephemeral"
    [ -f "$dir/disk.qcow2" ] || {
        note "creating disposable qcow2 overlay for qemubox-$name"
        qemu-img create -f qcow2 -F qcow2 -b "$base" "$dir/disk.qcow2" "$DISK" >/dev/null
        printf '%s\n' "$image_id" > "$dir/image-id"
    }
}

running() {
    dir="$(box_dir "$1")"
    [ -s "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null
}

ssh_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    shift
    agent=()
    [ -n "$ssh_agent" ] && agent=(-A)
    gpg=()
    [ -n "$gpg_sock" ] && gpg=(-o StreamLocalBindUnlink=yes -R "$GUEST_HOME/.gnupg/S.gpg-agent:$gpg_sock")
    docker=()
    [ -n "$docker_sock" ] && docker=(-R "$docker_remote:$docker_sock")
    ssh -i "$dir/key" -p "$(port_for "$name")" \
        "${agent[@]}" \
        "${gpg[@]}" \
        "${docker[@]}" \
        -o UserKnownHostsFile="$dir/known_hosts" \
        -o StrictHostKeyChecking=accept-new \
        "$GUEST_USER@127.0.0.1" "$@"
}

ssh_plain_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    shift
    ssh -i "$dir/key" -p "$(port_for "$name")" \
        -o UserKnownHostsFile="$dir/known_hosts" \
        -o StrictHostKeyChecking=accept-new \
        "$GUEST_USER@127.0.0.1" "$@"
}

# Guest voice: run a guest command and stream its output behind a dim gutter so
# it reads as "inside the VM". ONLY for standalone, human-facing calls whose
# output is neither captured nor used for control flow -- the gutter pipe plus
# `pipefail` would corrupt the exit status of those. Off a TTY it is exactly
# ssh_plain_box (no pipe), so behavior and output stay byte-for-byte unchanged.
ssh_stream_box() {
    if [ -t 2 ]; then
        ssh_plain_box "$@" 2>&1 | sed $'s/^/\033[2m> \033[0m/' >&2
    else
        ssh_plain_box "$@"
    fi
}

quote() {
    printf "%q" "$1"
}

add_mount() {
    src="$1"
    dest="$2"
    mode="$3"
    [ -e "$src" ] || return 0
    case "$src" in
        *,*) echo "Cannot 9p-mount path containing comma: $src" >&2; exit 2 ;;
    esac
    tag="qbx${#mount_tags[@]}"
    mount_tags+=("$tag")
    mount_srcs+=("$src")
    mount_dests+=("$dest")
    mount_modes+=("$mode")
}

stage_host_cfg() {
    cfg="$1"
    mkdir -p "$cfg/.gnupg"
    chmod 700 "$cfg"
    for rel in "${host_cfg_files[@]}"; do
        if [ -f "$HOME/$rel" ]; then
            cp -pL "$HOME/$rel" "$cfg/$rel"
        else
            rm -f "$cfg/$rel"
        fi
    done
}

qemu_mount_args() {
    for i in "${!mount_tags[@]}"; do
        ro=""
        [ "${mount_modes[$i]}" = ro ] && ro=",readonly=on"
        printf '%s\n' -virtfs
        printf 'local,path=%s,mount_tag=%s,security_model=none%s\n' \
            "${mount_srcs[$i]}" "${mount_tags[$i]}" "$ro"
    done
}

stage_ephemeral() {
    local output="$1" d name
    local mode=tmpfs find_expr=()
    [ -z "$eph_no_tmpfs" ] || mode=disk
    printf '%s\0' "$mode" > "$output"
    [ -z "$persist_builds$no_copy" ] || return 0
    for name in "${EPHEMERAL_DIRS[@]}"
    do
        [ "${#find_expr[@]}" -eq 0 ] || find_expr+=(-o)
        find_expr+=(-name "$name")
    done
    for d in "${dirs[@]}"
    do
        find "$d" -maxdepth 4 -type d \
            \( "${find_expr[@]}" \) -prune -print0 >> "$output"
    done
}

setup_guest_tmp() {
    ssh_stream_box "$1" 'set -e
sudo mount -t tmpfs -o rw,exec,mode=1777 tmpfs /tmp
sudo mkdir -p /tmp/cargo-target
sudo mount -t tmpfs -o "rw,exec,mode=1777,uid=$(id -u),gid=$(id -g)" \
    tmpfs /tmp/cargo-target'
}

setup_guest_builds() {
    ssh_stream_box "$1" \
        "sudo bash -s -- $(id -u) $(id -g) /run/qemubox/config/ephemeral" <<'EOF'
set -Eeuo pipefail
uid=$1
gid=$2
i=0
{
    IFS= read -r -d '' mode
    while IFS= read -r -d '' path
    do
        mkdir -p -- "$path"
        case "$mode" in
            tmpfs)
                mount -t tmpfs -o "rw,exec,mode=1777,uid=$uid,gid=$gid" tmpfs "$path"
                ;;
            disk)
                backing="/var/lib/qemubox/builds/$i"
                mkdir -p "$backing"
                chown "$uid:$gid" "$backing"
                mount --bind "$backing" "$path"
                ;;
            *) echo "Invalid build mount mode: $mode" >&2; exit 1 ;;
        esac
        i=$((i + 1))
    done
} < "$3"
EOF
}

start_box() {
    name="$(box_name "$1")"
    missing_deps
    dir="$(box_dir "$name")"
    mkdir -p "$dir"
    port="$(port_for "$name")"
    # Serialize concurrent same-name launches so two invocations don't both
    # ssh-keygen / qemu-img / boot a second qemu on one disk and port. Held only
    # through boot; released before the long-lived interactive session.
    exec 9>"$dir/.lock"
    flock 9
    ensure_box "$name"
    running "$name" && {
        note "reusing running VM qemubox-$name on 127.0.0.1:$port"
        booted=""
        flock -u 9
        return
    }
    # Fresh boot: from the name-hash port, walk up to the first free one and
    # persist it to $dir/port, so re-entry and ssh reuse the same port and a
    # name-hash collision with another box reallocates instead of failing.
    if [ ! -s "$dir/port" ]; then
        for _ in $(seq 1 100); do
            (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || break
            port=$(( (port - 10000 + 1) % 50000 + 10000 ))
        done
        echo "$port" > "$dir/port"
    fi
    accel=()
    [ -e /dev/kvm ] && accel=(-enable-kvm)
    restrict=",restrict=on"
    [ -n "$network" ] && restrict=""
    if [ "${#accel[@]}" -gt 0 ]; then
        note "starting qemubox-$name with KVM acceleration"
    else
        note "starting qemubox-$name without KVM; software emulation is slower"
    fi
    if [ -n "$network" ]; then
        note "guest network: outbound enabled"
    else
        note "guest network: restricted; only host SSH forwarding is open"
    fi
    mapfile -t mounts < <(qemu_mount_args)
    # Docker-built initramfs can detect host swap; this VM must not wait for it.
    "$QEMU" "${accel[@]}" \
        -cpu host -machine q35 -m "$MEM" -smp "$CPUS" \
        -drive "file=$dir/disk.qcow2,if=virtio,format=qcow2" \
        -kernel "$ROOT/base/$image_id.vmlinuz" -initrd "$ROOT/base/$image_id.initrd" \
        -append "root=/dev/vda rw console=ttyS0 noresume" \
        -virtfs "local,path=$dir/config,mount_tag=qbxcfg,security_model=none,readonly=on" \
        "${mounts[@]}" \
        -nic "user,model=virtio$restrict,hostfwd=tcp:127.0.0.1:$port-:22" \
        -serial "file:$dir/serial.log" \
        -display none -daemonize -pidfile "$dir/pid"
    note "waiting for SSH on 127.0.0.1:$port"
    note "why: qemubox-init must finish user/key setup before commands can run"
    for i in $(seq 1 90); do
        ssh_plain_box "$name" "test -f /run/qemubox/ready" >/dev/null 2>&1 && { booted=1; flock -u 9; return; }
        [ $((i % 10)) -eq 0 ] && note "still waiting for SSH; serial log: $dir/serial.log"
        sleep 2
    done
    # SSH never came up: kill the daemonized qemu so a boot that never reached
    # SSH isn't orphaned holding RAM/CPU and the rw 9p mounts.
    pid="$(cat "$dir/pid" 2>/dev/null || true)"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    rm -f "$dir/pid"
    echo "SSH not ready; see $dir/serial.log" >&2
    exit 1
}

detect_gpg() {
    gpg_sock="$(gpgconf --list-dirs agent-socket 2>/dev/null || true)"
    # A socket FILE can outlive its agent; probe liveness so -K doesn't forward a
    # dead socket (which surfaces as a confusing "no agent" inside the guest).
    if [ -S "$gpg_sock" ] && gpg-connect-agent /bye >/dev/null 2>&1; then
        return
    fi
    if [ -n "$gpg_sock" ]; then
        note "-K: host gpg-agent not answering ($gpg_sock); run 'gpgconf --launch gpg-agent' -- not forwarding"
    fi
    gpg_sock=""
}

setup_guest_auth() {
    name="$1"
    ssh_plain_box "$name" "mkdir -p ~/.gnupg && chmod 700 ~/.gnupg"
    if [ -n "$gpg_sock" ]; then
        note "forwarding gpg-agent into qemubox-$name over SSH"
        note "why: this mirrors dockbox's gpg-agent socket mount without sharing a host filesystem"
    fi
}

mount_host_paths() {
    name="$1"
    note "mounting host paths into qemubox-$name with 9p"
    note "why: qemubox mirrors dockbox access patterns without copying files"
    ssh_plain_box "$name" 'sudo modprobe -a 9p 9pnet_virtio'
    ssh_plain_box "$name" 'grep -qw 9p /proc/filesystems' || {
        note "guest kernel lacks 9p filesystem support; rebuild with qemubox build-base --force"
        exit 1
    }
    for i in "${!mount_tags[@]}"; do
        tag="${mount_tags[$i]}"
        dest="${mount_dests[$i]}"
        opts="trans=virtio,version=9p2000.L,msize=104857600"
        [ "${mount_modes[$i]}" = ro ] && opts="$opts,ro"
        ssh_plain_box "$name" "sudo mkdir -p $(quote "$dest")"
        ssh_plain_box "$name" "mountpoint -q $(quote "$dest") || sudo mount -t 9p -o $(quote "$opts") $(quote "$tag") $(quote "$dest")"
    done
}

setup_guest_runtime() {
    name="$1"
    settings='--settings '\''{"sandbox":{"enabled":false}}'\'''
    wrapper_edit="s/--dangerously-skip-permissions \"/--dangerously-skip-permissions $settings \"/"
    ssh_plain_box "$name" "sudo sed -i $(quote "$wrapper_edit") /usr/local/bin/claude"
    ssh_stream_box "$name" 'set -e
mkdir -p ~/.docker/run ~/.gnupg
chmod 700 ~/.gnupg
sudo tee /usr/local/bin/codex >/dev/null <<'\''EOF'\''
#!/bin/sh
exec /opt/dev-tools/bun/bin/codex --dangerously-bypass-approvals-and-sandbox "$@"
EOF
sudo chmod 755 /usr/local/bin/codex'
    ssh_stream_box "$name" 'set -e
if [ -f /mnt/qemubox-home/.claude.json ]
then
    ln -sf /mnt/qemubox-home/.claude.json /tmp/host-claude.json
fi
for rel in .gitconfig .gnupg/pubring.kbx .gnupg/pubring.gpg
do
    if [ -f "/mnt/qemubox-home/$rel" ]
    then
        ln -sf "/mnt/qemubox-home/$rel" "$HOME/$rel"
    fi
done
if [ -f /mnt/qemubox-history/history ]
then
    for rel in .bash_history .zsh_history
    do
        touch "$HOME/$rel"
        sudo mount --bind /mnt/qemubox-history/history "$HOME/$rel"
    done
fi'
}

stop_box() {
    name="$(box_name "$1")"
    running "$name" || return 0
    dir="$(box_dir "$name")"
    pid="$(cat "$dir/pid")"
    ssh_box "$name" sudo poweroff >/dev/null 2>&1 || true
    # Wait for a clean guest shutdown (systemd can take ~90s), then escalate
    # SIGTERM -> SIGKILL so a wedged VM is terminated, never left as an orphaned
    # qemu whose disk remove_box is about to unlink.
    for _ in $(seq 1 90); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    for _ in $(seq 1 5); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    if kill -0 "$pid" 2>/dev/null; then
        echo "VM still running as PID $pid" >&2
        return 1
    fi
    rm -f "$dir/pid"
}

remove_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    # Never delete a box's disk/keys while its VM is still alive -- stop_box now
    # escalates to SIGKILL, so a failure here means it genuinely could not die.
    stop_box "$name" || { echo "qemubox-$name still running; not removing its files" >&2; return 1; }
    rm -f "$dir/config/identity" "$dir/config/authorized_keys" \
        "$dir/config/ephemeral" "$dir/image-id"
    if [ -d "$dir/config" ]
    then
        rmdir "$dir/config"
    fi
    rm -f "$dir/disk.qcow2" "$dir/seed.iso" "$dir/user-data" "$dir/meta-data"
    rm -f "$dir/serial.log" "$dir/pid" "$dir/known_hosts" "$dir/key" "$dir/key.pub" "$dir/.lock" "$dir/port"
    for rel in "${host_cfg_files[@]}"; do rm -f "$dir/hostcfg/$rel"; done
    rm -f "$dir/history/history"
    if [ -d "$dir/history" ]
    then
        rmdir "$dir/history"
    fi
    rmdir "$dir/hostcfg/.gnupg" "$dir/hostcfg" 2>/dev/null || true
    rmdir "$dir" 2>/dev/null || true
    echo "removed qemubox-$name"
}

build_base() (
    set -Eeuo pipefail
    force="${1:-}"
    source_dir="${QEMUBOX_SOURCE:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")}"
    [ -f "$source_dir/dockbox/Dockerfile" ] || {
        echo "Set QEMUBOX_SOURCE to the tools repo containing dockbox/Dockerfile" >&2
        exit 1
    }
    read -r -a docker_cmd <<< "${QEMUBOX_DOCKER:-docker}"
    mkdir -p "$ROOT/base"
    exec 8>"$ROOT/base/.lock"
    flock 8
    build_args=()
    [ -z "$force" ] || build_args+=(--build-arg "AGENTS_CACHEBUST=$(date +%s)")
    "${docker_cmd[@]}" build --force-rm --target vm -t qemubox-vm \
        "${build_args[@]}" -f "$source_dir/dockbox/Dockerfile" "$source_dir"
    image_id=$("${docker_cmd[@]}" image inspect -f '{{.Id}}' qemubox-vm)
    image_id=${image_id#sha256:}
    [[ "$image_id" =~ ^[a-f0-9]{64}$ ]]
    base="$ROOT/base/$image_id"
    if [ ! -s "$base.qcow2" ] || [ ! -s "$base.vmlinuz" ] || [ ! -s "$base.initrd" ]
    then
        tmp=$(mktemp -d /tmp/qemubox-image.XXXXXX)
        container=""
        cleanup_image() {
            rc=$?
            trap - EXIT
            if [ -n "$container" ]
            then
                "${docker_cmd[@]}" rm "$container" >/dev/null || rc=1
            fi
            rm -f "$tmp/export.tar" "$tmp/rootfs.tar" "$tmp/rootfs.raw" \
                "$base.qcow2.tmp" "$base.vmlinuz.tmp" "$base.initrd.tmp"
            rmdir "$tmp"
            exit "$rc"
        }
        trap cleanup_image EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        note "exporting VM rootfs: $image_id"
        container=$("${docker_cmd[@]}" create "$image_id")
        "${docker_cmd[@]}" export -o "$tmp/export.tar" "$container"
        "${docker_cmd[@]}" rm "$container" >/dev/null
        container=""
        bsdtar -cf "$tmp/rootfs.tar" --exclude=.dockerenv "@$tmp/export.tar"
        rm "$tmp/export.tar"
        kernel=$(tar -tf "$tmp/rootfs.tar" | sed -n 's,^boot/vmlinuz-,,p' | sort -V | tail -1)
        [ -n "$kernel" ]
        tar -xOf "$tmp/rootfs.tar" "boot/vmlinuz-$kernel" > "$base.vmlinuz.tmp"
        tar -xOf "$tmp/rootfs.tar" "boot/initrd.img-$kernel" > "$base.initrd.tmp"
        note "creating ext4 base in /tmp"
        mke2fs -q -t ext4 -F -d "$tmp/rootfs.tar" "$tmp/rootfs.raw" 20G
        note "converting base to qcow2"
        qemu-img convert -O qcow2 "$tmp/rootfs.raw" "$base.qcow2.tmp"
        mv "$base.vmlinuz.tmp" "$base.vmlinuz"
        mv "$base.initrd.tmp" "$base.initrd"
        mv "$base.qcow2.tmp" "$base.qcow2"
    fi
    printf '%s\n' "$image_id" > "$ROOT/base/current"
    note "base ready: $base.qcow2"
)

list_boxes() {
    mkdir -p "$ROOT"
    found=""
    for dir in "$ROOT"/*; do
        [ -d "$dir" ] || continue
        [ "${dir##*/}" = base ] && continue
        [ -n "$found" ] || printf "NAME\tSTATUS\tSSH\tPATH\n"
        found=1
        name="${dir##*/}"
        state=stopped
        running "$name" && state=running
        printf "qemubox-%s\t%s\t127.0.0.1:%s\t%s\n" \
            "$name" "$state" "$(port_for "$name")" "$dir"
    done
    [ -n "$found" ] || echo "no qemubox VMs"
}

# Report a box's readiness from the pidfile / serial log / SSH port only -- no
# shell into the guest -- so a wedged VM (process up, SSH dead) is distinguishable
# from a healthy one, which plain "running" in ls cannot show.
status_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    [ -d "$dir" ] || { echo "no qemubox VM named '$name'" >&2; exit 1; }
    port="$(port_for "$name")"
    proc=stopped; running "$name" && proc=running
    ssh_state=closed
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && ssh_state=open
    boot=pending
    [ -f "$dir/serial.log" ] && grep -qiE 'qemubox: ready|login:' "$dir/serial.log" && boot=ready
    printf "qemubox-%s\tprocess=%s\tssh=%s\tboot=%s\tport=%s\n" \
        "$name" "$proc" "$ssh_state" "$boot" "$port"
    # 9p mounts are set up post-boot over SSH, not at boot, so they never appear
    # in the serial log; enter the box (qemubox bash) to inspect them.
}

add_env() {
    var="$1"
    case "$var" in
        ""|*[!A-Za-z0-9_]*|[0-9]*)
            echo "Invalid env var: $var" >&2
            exit 2 ;;
    esac
    val="${!var-}"
    envs+=("$var=$val")
}

copy_arg() {
    # Strip only a trailing mode suffix so paths that themselves contain a colon
    # survive (the mode is parsed from the full arg by the caller).
    path="$1"
    case "$path" in
        *:rw) path="${path%:rw}" ;;
        *:ro) path="${path%:ro}" ;;
    esac
    case "$path" in
        /*|./*|.|~*) printf '%s' "$path" ;;
        *) echo "Invalid -v path: $1" >&2; exit 2 ;;
    esac
}

apply_flag() {
    case "$1" in
        n)
            # box_name keeps '.', so reject traversal/reserved names here in the
            # main shell (apply_flag runs un-subshelled) where exit stops the run.
            case "$2" in
                ""|.|..|base|.build|*/*)
                    echo "qemubox: invalid -n name: '$2'" >&2; exit 2 ;;
            esac
            name_override="$2" ;;
        d|x) entrypoint="$2"; entrypoint_explicit=1 ;;
        e) add_env "$2" ;;
        v)
            extra_dirs+=("$(copy_arg "$2")")
            case "$2" in
                *:rw) extra_modes+=(rw) ;;
                *) extra_modes+=(ro) ;;
            esac ;;
        N) no_copy=1 ;;
        H) network="" ;;
        U) untrusted=1; network="" ;;
        A) ssh_agent=1 ;;
        D)
            if [ -S /var/run/docker.sock ]; then
                docker_sock=/var/run/docker.sock
                docker_remote="$GUEST_HOME/.docker/run/docker.sock"
                envs+=("DOCKER_HOST=unix://$docker_remote")
            else
                warnings+=("-D ignored: /var/run/docker.sock is not available")
            fi ;;
        K) gpg_forward=1 ;;
        S) warnings+=("-S ignored: qemubox guest user already has passwordless sudo") ;;
        P) persist_builds=1 ;;
        T) eph_no_tmpfs=1 ;;
        g)
            [ -n "${GH_TOKEN:-}" ] && envs+=("GH_TOKEN=$GH_TOKEN")
            [ -n "${GITHUB_TOKEN:-}" ] && envs+=("GITHUB_TOKEN=$GITHUB_TOKEN") ;;
        G) gcloud_creds=1 ;;
        *) usage >&2; exit 2 ;;
    esac
    return 0  # never let a falsey last branch (e.g. -g with no token) trip set -e
}

tool_cmd() {
    case "$1" in
        claude) cmd=(claude --model claude-opus-5-5 --effort xhigh) ;;
        codex) cmd=(codex) ;;
        haiku) cmd=(claude --model claude-haiku-4-5-20251001) ;;
        sonnet) cmd=(claude --model claude-sonnet-5-5 --effort high) ;;
        opus) cmd=(claude --model claude-opus-5-5 --effort xhigh) ;;
        fable) cmd=(claude --model claude-fable-5-1) ;;
        gpt) cmd=(codex -m gpt-6-astra) ;;
        mini) cmd=(codex -m gpt-5.4-mini) ;;
        spark) cmd=(codex -m gpt-5.3-codex-spark) ;;
        sh|bash) cmd=(bash -l) ;;
        zsh) cmd=(zsh -l) ;;
        *) cmd=("$1") ;;
    esac
}

# Decide whether box $1 matches the user's rm pattern $2. Empty pattern -> all;
# a pattern containing * or ? is a glob, otherwise an exact name match.
rm_matches() {
    _n="$1"; _pat="$2"
    [ -z "$_pat" ] && return 1  # empty never matches; the caller requires a pattern (use '*' for all)
    case "$_pat" in
        *[*?]*) case "$_n" in $_pat) return 0 ;; *) return 1 ;; esac ;;
        *) [ "$_n" = "$_pat" ] ;;
    esac
}

# -U injects nothing: neutralize every credential-forwarding flag before mounts
# and forwards are assembled. assemble_mounts already skips the config mounts
# under $untrusted; this also drops -A/-D/-K/-G/-g so they cannot smuggle a live
# credential into an "untrusted" box. Operates on the parsing globals.
apply_untrusted() {
    dropped=""
    [ -n "$ssh_agent$docker_sock$gpg_forward$gcloud_creds" ] && dropped=1
    ssh_agent=""; docker_sock=""; docker_remote=""; gpg_forward=""; gcloud_creds=""
    kept=()
    for e in "${envs[@]}"; do
        case "$e" in GH_TOKEN=*|GITHUB_TOKEN=*|DOCKER_HOST=*) dropped=1 ;; *) kept+=("$e") ;; esac
    done
    envs=("${kept[@]}")
    [ -n "$dropped" ] && warnings+=("-U: dropping credential-forwarding flags (-A/-D/-K/-G/-g); untrusted mode injects nothing")
    case "${entrypoint:-}" in
        claude|codex|haiku|sonnet|opus|fable|gpt|mini|spark)
            warnings+=("-U: no credentials injected; the agent cannot authenticate -- use bash/build/test") ;;
    esac
}

# Build the 9p mount list (mount_* arrays) for the resolved flag set. Reads the
# globals set during argument parsing; called once from the main flow.
assemble_mounts() {
    if [ -z "$untrusted" ]; then
        host_cfg="$(box_dir "$name")/hostcfg"
        stage_host_cfg "$host_cfg"
        add_mount "$host_cfg" "/mnt/qemubox-home" ro
        for d in .claude .codex .agents; do
            add_mount "$HOME/$d" "$HOME/$d" rw
        done
        history_dir="$(box_dir "$name")/history"
        mkdir -p "$history_dir"
        chmod 700 "$history_dir"
        [ -f "$HOME/.dockbox_history" ] || touch "$HOME/.dockbox_history"
        if [ ! "$HOME/.dockbox_history" -ef "$history_dir/history" ]
        then
            ln -fL "$HOME/.dockbox_history" "$history_dir/history"
        fi
        add_mount "$history_dir" /mnt/qemubox-history rw
    fi
    [ -n "$gcloud_creds" ] && add_mount "$HOME/.config/gcloud" "$GUEST_HOME/.config/gcloud" ro
    if [ -z "${no_copy:-}" ]; then
        for dir in "${dirs[@]}"; do
            add_mount "$dir" "$dir" rw
        done
    fi
    for i in "${!extra_dirs[@]}"; do
        dir="$(cd "${extra_dirs[$i]}" && pwd)"
        add_mount "$dir" "$dir" "${extra_modes[$i]}"
    done
    return 0
}

# Sourcing with QEMUBOX_LIB=1 loads the helpers above without running the CLI,
# so tests can exercise them directly.
[ -n "${QEMUBOX_LIB:-}" ] && return 0

case "${1:-}" in
    ls) list_boxes; exit 0 ;;
    status)
        [ -n "${2:-}" ] || { echo "usage: qemubox status <name>" >&2; exit 2; }
        status_box "$2"; exit 0 ;;
    rm|destroy)
        pat="${2:-}"
        [ -z "$pat" ] && { echo "qemubox rm: a name or glob is required (-a / '*' removes all)" >&2; exit 2; }
        case "$pat" in -a|--all) pat='*' ;; esac
        found=""
        for dir in "$ROOT"/*; do
            [ -d "$dir" ] || continue
            name="${dir##*/}"
            [ "$name" = base ] && continue
            rm_matches "$name" "$pat" || continue
            found=1
            remove_box "$name" || true
        done
        if [ -z "$found" ]; then
            if [ -n "$pat" ]; then
                echo "no match for '$pat'"
            else
                echo "no qemubox VMs"
            fi
        fi
        exit 0 ;;
    prune)
        hours="${2:-2160}"
        cutoff=$(date -d "-$hours hours" +%s 2>/dev/null) || cutoff=$(date -v-"$hours"H +%s)
        for dir in "$ROOT"/*; do
            [ -d "$dir" ] || continue
            name="${dir##*/}"
            [ "$name" = base ] && continue
            running "$name" && continue
            # A dir vanishing between the glob and here (concurrent rm/prune)
            # must skip, not trip set -e and abort the whole prune.
            ts=$(stat -c %Y "$dir" 2>/dev/null || stat -f %m "$dir" 2>/dev/null) || continue
            [ "$ts" -lt "$cutoff" ] && remove_box "$name" || true
        done
        exit 0 ;;
    build-base)
        force=""
        case "${2:-}" in
            ""|--force|-f|rebuild) [ -n "${2:-}" ] && force=1 ;;
            *) echo "unknown build-base option: $2" >&2; exit 2 ;;
        esac
        build_base "$force"
        exit 0 ;;
    -h|--help|help) usage; exit 0 ;;
esac

_args=()
for a in "$@"; do
    case "$a" in
        --no-ephemeral) persist_builds=1 ;;
        --untrusted) untrusted=1; network="" ;;
        *) _args+=("$a") ;;
    esac
done
set -- "${_args[@]}"

while getopts ":n:d:x:e:v:HKUADgGPTSN" opt; do
    apply_flag "$opt" "${OPTARG:-}"
done
shift $((OPTIND - 1))

if [ -z "$entrypoint_explicit" ] && [ "$#" -gt 0 ]; then
    case "$1" in
        /*|./*|.|~*) : ;;
        *) entrypoint="$1"; shift ;;
    esac
fi

if [ "$entrypoint" = exec ]; then
    [ "$#" -gt 0 ] || { echo "qemubox exec: a command is required" >&2; exit 2; }
    cmd=("$@"); set --
else
    tool_cmd "$entrypoint"
fi

for arg in "$@"; do
    case "$arg" in
        /*|./*|.|~*) dirs+=("$(cd "$arg" && pwd)") ;;
        *) args+=("$arg") ;;
    esac
done

[ "${#dirs[@]}" -gt 0 ] || dirs=("$(pwd)")
primary="${dirs[-1]}"
name="$(box_name "${name_override:-${primary##*/}}")"

[ -n "$untrusted" ] && apply_untrusted

assemble_mounts

[ -n "$gpg_forward" ] && detect_gpg
start_box "$name"
# Drop this session's ref-count marker BEFORE provisioning, so a sibling session
# exiting mid-setup cannot see left=0 and tear the VM down under us.
sid="$$"
ssh_plain_box "$name" "sudo mkdir -p /run/qemubox/sess && sudo touch /run/qemubox/sess/$sid" >/dev/null 2>&1 || true
# A running box's 9p device set is fixed at boot, so re-provisioning it with a
# different mount set fails hard; skip it on re-entry (matches dockbox), where
# mount/-v/dir changes don't apply. The tool/model still applies to the session.
# $booted is set from inside start_box's flock (1 = we just booted; "" = reused),
# so this is race-free against a concurrent first launch of the same box.
if [ -n "$booted" ]; then
    setup_guest_tmp "$name"
    mount_host_paths "$name"
    setup_guest_builds "$name"
    setup_guest_runtime "$name"
    setup_guest_auth "$name"
else
    note "re-entering running qemubox-$name; mount/-v/dir changes are ignored (use -n <name> for a separate box)"
fi

for warning in "${warnings[@]}"; do
    note "$warning"
done

workdir=""
if [ -z "${no_copy:-}" ]; then
    workdir="$primary"
fi

remote=""
envs+=("CARGO_TARGET_DIR=/tmp/cargo-target")
for arg in "${envs[@]}" "${cmd[@]}" "${args[@]}"; do
    printf -v q "%q" "$arg"
    remote="$remote $q"
done

# Ref-counted session lifecycle (mirrors dockbox): the marker was dropped right
# after start_box; run the session, then remove the marker and count what's left.
# When the last session exits, tear the disposable VM down so none is left idle;
# concurrent sessions each hold a marker and keep it up until all have exited.
rc=0
if [ -n "$workdir" ]; then
    note "running in qemubox-$name:$workdir"
    ssh_box "$name" -t "cd $(quote "$workdir") && exec env$remote" || rc=$?
else
    note "running in qemubox-$name home"
    ssh_box "$name" -t "exec env$remote" || rc=$?
fi
# Only tear down when the remaining-session count SUCCEEDS and is zero. An ssh
# hiccup while counting leaves $left empty -> keep the VM up (a sibling may still
# hold it); prune reaps a genuinely idle box later. Never teardown on error.
left="$(ssh_plain_box "$name" "sudo rm -f /run/qemubox/sess/$sid; ls /run/qemubox/sess 2>/dev/null | wc -l" 2>/dev/null)" || left=""
if [ -n "$left" ] && [ "$left" -eq 0 ]; then
    note "last session exited -- shutting down qemubox-$name"
    remove_box "$name" >/dev/null || true
fi
exit "$rc"
