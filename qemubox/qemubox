#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${QEMUBOX_HOME:-$HOME/.local/share/qemubox}"
MEM="${QEMUBOX_MEM:-65536}"
CPUS="${QEMUBOX_CPUS:-4}"
DISK="${QEMUBOX_DISK:-40G}"
LINGER="${QEMUBOX_LINGER:-1200}"
GUEST_USER="$(id -un)"
GUEST_HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
QEMU="${QEMUBOX_QEMU:-qemu-system-x86_64}"
EPHEMERAL_DIRS=(node_modules .venv .next .turbo .cache)
TMP_WORKDIR=/tmp/work
agent_tokens=(CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY)

name_override=""
entrypoint="claude"
entrypoint_explicit=""
network=1
ssh_agent=""
gpg_sock=""
docker_sock=""
docker_remote=""
persist_builds=""
eph_no_tmpfs=""
tmp_session=""
mount_sensitive=""
new_session=""
gcloud_creds=""
gpg_forward=""
untrusted=""
booted=""
locked=""
sid=""
session_pid=""
args=()
dirs=()
extra_dirs=()
extra_modes=()
envs=()
warnings=()
mount_tags=()
mount_srcs=()
mount_dests=()
mount_modes=()

host_cfg_files=(.claude.json .gitconfig .gnupg/pubring.kbx .gnupg/pubring.gpg)

usage() {
    cat <<EOF
Usage: qemubox [options] [tool] [dirs...] [tool-args...]
       qemubox ls | status <name> | stop <name|glob|-a>... [-f]
       qemubox rm <name|glob|-a>... | rm --stopped <hours> | prune
       qemubox build-base [-f|--force]
       qemubox [options] bash [dirs...]
       qemubox [options] exec <cmd> [args...]

Tools (first positional arg -- no leading dash):
    (default)       Claude Code, opus @ xhigh effort
    claude          Claude Code, opus (same as default)
    codex           Codex -m gpt-6.1-sol @ xhigh
    haiku           Claude Code --model claude-haiku-4-5-20251001
    sonnet          Claude Code --model claude-sonnet-5-5 --effort high
    opus            Claude Code --model claude-opus-5-5 --effort xhigh
    fable           Claude Code --model claude-fable-5-1
    gpt             Codex -m gpt-6-astra
    mini            Codex -m gpt-5.4-mini
    spark           Codex -m gpt-5.3-codex-spark
    bash|zsh|sh     Interactive login shell (sh is an alias for bash)
    exec <cmd>      Run <cmd> in the box, every later arg passed through
    <any cmd>       Any binary installed in the VM
    A --model/-m after the tool replaces the alias's model and effort.

Options:
    -n name    Override VM name (default: qemubox-<project>)
    -d tool    Explicit tool (same as first-arg tool, useful in scripts)
    -x tool    Alias for -d, matching dockbox
    -e VAR     Forward env var into the session
    -v path    Extra 9p mount at same path ro by default; path:rw for read-write
    -T         Temporary session: mount no project dir, start in $TMP_WORKDIR
               (guest tmpfs, lost at power-off); a new random VM name
               unless -n; implies -N
    --mount-sensitive
               Mount a sensitive path: /, a top-level dir, \$HOME, an
               ancestor of \$HOME or a hidden dir in \$HOME. Without it, such
               a path is an error, and a run from one with no dir acts as -T
    -N         New Claude session: skip the resume picker
    -H         Egress kill-switch: disable the guest's outbound network
    -U         Untrusted: inject NO host config/credentials, force network off,
               but still mount the project dir(s). --untrusted also works.
               The agent cannot authenticate here -- use it for bash/build/test.
    -A         Forward SSH agent
    -D         Forward Docker socket over SSH
    -K         Forward gpg-agent (commit signing); off by default
    -S         Accepted for dockbox parity; guest user already has sudo
    -g         Forward GH_TOKEN / GITHUB_TOKEN into the session
    -G         Mount ~/.config/gcloud ro
    -P         Keep project build dirs on the host (--no-ephemeral)
    -B         Put build-dir overmounts on guest disk; /tmp stays tmpfs

Examples:
    qemubox
    qemubox ~/src/repo
    qemubox haiku ~/src/repo
    qemubox codex ~/src/repo
    qemubox bash
    qemubox -n mybox bash
    qemubox -T bash
    qemubox cargo test ~/src/repo
    qemubox -H cargo test ~/src/repo
    qemubox -v ~/src/lib ~/src/repo
    qemubox ls
    qemubox stop repo
    qemubox rm repo

Ingress: dirs and config are mounted into the VM with QEMU 9p.
SSH is only the control channel used to enter the guest.
~/.claude/sessions is a private tmpfs in the guest: VMs and the host never
list or message each other's Claude sessions.

Sandbox note: /etc/claude-code/CLAUDE.md (written at boot) tells the agent it
is boxed and what survives; CLAUDE_SANDBOX=qemubox is set.

Environment: QEMUBOX_MEM=65536 QEMUBOX_CPUS=4 QEMUBOX_DISK=40G
             QEMUBOX_QEMU=qemu-system-x86_64 (the qemu binary)
Memory: the host backs guest RAM as the guest touches it and takes freed pages
        back (virtio-balloon free page reporting). Guest /tmp is a tmpfs capped
        at 75% of RAM. /tmp/cargo-target and the build-dir mounts live on it,
        so a full /tmp gives ENOSPC, not an out-of-memory guest. Process
        memory is not counted against the cap.
Build: QEMUBOX_SOURCE=<tools repo> QEMUBOX_DOCKER="docker"
Readiness: QEMUBOX_READY_TIMEOUT=180 (seconds)
Config: ~/.qemuboxrc defaults; project .qemuboxrc safe flags only.
        Project files cannot set -A/-D/-K/-S/-T/-n/-d/-x.
Lifecycle: the VM stays up QEMUBOX_LINGER=1200 seconds after the last session
           exits, then powers off (0: at once); disk survives until rm.
Stop: qemubox stop resumes a paused guest, trims its disk, asks it to power
      off and waits up to 90s before stopping qemu; -f stops qemu at once
      (quit over QMP or SIGTERM, then SIGKILL).
Prune: stop running VMs idle past 4 hours; never removes a VM. Reclaim
       unreferenced bases except current.
Remove: rm --stopped <hours> removes VMs stopped for over that many whole hours.
State: $ROOT
EOF
}

box_name() {
    printf '%s' "${1:-default}" | tr -c 'A-Za-z0-9_.-' '-'
}

box_dir() {
    printf '%s/%s' "$ROOT" "$(box_name "$1")"
}

random_name() {
    local adjectives=(bold brave calm clever eager fond gentle happy humble jolly
        keen lively lucid merry nifty proud quirky serene sharp tender upbeat vivid
        witty zealous)
    local names=(babbage backus berners cerf church curie dijkstra hamilton hopper
        kay knuth liskov lovelace mccarthy noether pike ritchie shannon stallman
        thompson torvalds turing wirth wozniak)
    local n
    while :
    do
        n="${adjectives[RANDOM % ${#adjectives[@]}]}_${names[RANDOM % ${#names[@]}]}"
        [ -e "$(box_dir "$n")" ] || break
    done
    printf '%s' "$n"
}

is_sensitive() {
    local path home
    path=$(realpath -m -- "$1")
    home=$(realpath -m -- "$HOME")
    [[ "$path" = / || "$path" =~ ^/[^/]+$ || "$home" = "$path" ||
        "$home" = "$path"/* || ( "${path%/*}" = "$home" && "${path##*/}" = .* ) ]]
}

port_for() {
    local dir cksum
    dir="$(box_dir "$1")"
    if [ -s "$dir/port" ]
    then
        cat "$dir/port"
        return
    fi
    cksum=$(printf '%s' "$(box_name "$1")" | cksum | awk '{print $1}')
    echo $((10000 + cksum % 50000))
}

missing_deps() {
    local miss="" dep deps=("$QEMU" qemu-img ssh ssh-keygen tar flock python3)
    [ "$#" -eq 0 ] || deps=("$@")
    for dep in "${deps[@]}"; do
        command -v "$dep" >/dev/null 2>&1 || miss="$miss $dep"
    done
    [ -z "$miss" ] || {
        echo "Missing:$miss" >&2
        echo "Install qemubox system dependencies listed in qemubox/README.md." >&2
        exit 1
    }
}

note() {
    if [ -t 2 ]; then
        printf '\033[1;36m>>> qemubox:\033[0m %s\n' "$*" >&2 || :
    else
        printf 'qemubox: %s\n' "$*" >&2 || :
    fi
}

ensure_base() {
    if [ ! -s "$ROOT/base/current" ]
    then
        build_base >&2
    fi
    image_id=$(cat "$ROOT/base/current")
    printf '%s/%s.qcow2\n' "$ROOT/base" "$image_id"
}

check_trust() {
    local dir mode saved=unknown
    dir="$(box_dir "$1")"
    [ -f "$dir/disk.qcow2" ] || return 0
    mode=trusted
    [ -z "$untrusted" ] || mode=untrusted
    [ ! -f "$dir/trust" ] || saved=$(cat "$dir/trust")
    [ "$saved" = "$mode" ] || {
        echo "qemubox-$1: disk trust is $saved, requested $mode; use -n for a new box or qemubox rm $1" >&2
        return 1
    }
}

ensure_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    mkdir -p "$dir"
    chmod 700 "$dir"
    check_trust "$name" || return 1
    [ -f "$dir/image-id" ] || ensure_base >/dev/null
    exec 8>"$ROOT/base/.lock"
    flock -s 8
    if [ -f "$dir/image-id" ]
    then
        image_id=$(cat "$dir/image-id")
        base="$ROOT/base/$image_id.qcow2"
    else
        base="$(ensure_base)"
        image_id=${base##*/}
        image_id=${image_id%.qcow2}
    fi
    for file in "$base" "$ROOT/base/$image_id.vmlinuz" "$ROOT/base/$image_id.initrd"
    do
        [ -s "$file" ] || {
            echo "Missing base file $file; run qemubox rm $name, then qemubox build-base" >&2
            exit 1
        }
    done
    [ -f "$dir/key" ] || {
        note "creating SSH key for qemubox-$name"
        ssh-keygen -t ed25519 -f "$dir/key" -N "" -C "qemubox-$name" >/dev/null
    }
    mkdir -p "$dir/config"
    chmod 700 "$dir/config"
    {
        printf '%s\n' "$GUEST_USER" "$(id -u)" "$(id -g)" "$GUEST_HOME"
        for gid in $(id -G)
        do
            gname=$(getent group "$gid" | cut -d: -f1) || gname=""
            [[ "$gname" =~ ^[A-Za-z0-9_-]+$ ]] || gname="hostgrp$gid"
            printf '%s:%s ' "$gid" "$gname"
        done
        printf '\n'
        printf '%s\n' Etc/UTC
    } > "$dir/config/identity"
    cp "$dir/key.pub" "$dir/config/authorized_keys"
    stage_ephemeral "$dir/config/ephemeral"
    [ -f "$dir/disk.qcow2" ] || {
        note "creating persistent qcow2 overlay for qemubox-$name"
        qemu-img create -f qcow2 -F qcow2 -b "$base" "$dir/disk.qcow2" "$DISK" >/dev/null
        printf '%s\n' "$image_id" > "$dir/image-id"
        mode=trusted
        [ -z "$untrusted" ] || mode=untrusted
        printf '%s\n' "$mode" > "$dir/trust"
    }
    flock -u 8
    exec 8>&-
}

running() {
    local dir pid state
    dir="$(box_dir "$1")"
    [ -s "$dir/pid" ] || return 1
    pid=$(cat "$dir/pid")
    state=$(ps -o stat= -p "$pid") || return 1
    [[ "$state" != Z* ]] || return 1
    grep -zFq -- "file=$dir/disk.qcow2," "/proc/$pid/cmdline"
}

qmp_box() {
    python3 - "$(box_dir "$1")" "$2" <<'EOF'
import json
import os
import socket
import sys

try:
    os.chdir(sys.argv[1])
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(5)
        sock.connect("qmp")
        qmp = sock.makefile("rw")
        qmp.readline()
        for command in ["qmp_capabilities", sys.argv[2]]:
            qmp.write(json.dumps({"execute": command}) + "\n")
            qmp.flush()
            reply = {"event": None}
            while "event" in reply:
                line = qmp.readline()
                if not line:
                    sys.exit(f"QMP closed before replying to {command}")
                reply = json.loads(line)
            if "error" in reply:
                sys.exit(f"QMP {command}: {reply['error']['desc']}")
except OSError as err:
    sys.exit(f"QMP {sys.argv[1]}/qmp: {err}")
print(reply["return"].get("status", ""))
EOF
}

run_state() {
    local state
    if ! running "$1"
    then
        state=stopped
    elif [ ! -S "$(box_dir "$1")/qmp" ]
    then
        state=running
    elif ! state=$(qmp_box "$1" query-status)
    then
        state="?"
    fi
    case "$state" in
        stopped|running|paused|"?") printf '%s\n' "$state" ;;
        *) printf 'paused:%s\n' "$state" ;;
    esac
}

ready_error() {
    echo "VM qemubox-$1 not ready; serial log: $(box_dir "$1")/serial.log" >&2
    tail -40 "$(box_dir "$1")/serial.log" >&2 || true
}

lock_box() {
    mkdir -p "$ROOT/.locks"
    exec 9>"$ROOT/.locks/$(box_name "$1")"
    flock -w "${QEMUBOX_READY_TIMEOUT:-180}" 9 || {
        ready_error "$1"
        return 1
    }
    locked=1
}

unlock_box() {
    flock -u 9
    exec 9>&-
    locked=""
}

wait_ready() {
    local name="$1" gate="$2" deadline state
    deadline=$((SECONDS + ${QEMUBOX_READY_TIMEOUT:-180}))
    while [ "$SECONDS" -lt "$deadline" ]
    do
        state=$(run_state "$name")
        if [[ "$state" = paused* ]]
        then
            echo "VM qemubox-$name is $state, not running; io-error means" \
                "the host disk under $ROOT filled. Free space, then run" \
                "qemubox stop $name" >&2
            return 1
        fi
        if [ "$gate" = boot ] || [ -f "$(box_dir "$name")/ready" ]
        then
            if ssh_plain_box "$name" "test -f /run/qemubox/ready" \
                >/dev/null 2>&1
            then
                return 0
            fi
        fi
        sleep 1
    done
    ready_error "$name"
    return 1
}

session_markers() {
    local markers marker
    [ -n "$locked" ] || { echo "Session count requires the VM lock" >&2; return 1; }
    markers=$(ssh_plain_box "$1" 'sudo ls -1 /run/qemubox/sess') || return 1
    for marker in $markers
    do
        [[ "$marker" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid session marker: $marker" >&2; return 1; }
        if kill -0 "$marker" 2>/dev/null
        then
            printf '%s\n' "$marker"
        else
            ssh_plain_box "$1" "sudo rm -f /run/qemubox/sess/$marker" || return 1
        fi
    done
}

has_idle_token() {
    [ "$(cat "$(box_dir "$1")/idle" 2>/dev/null)" = "$2" ]
}

stop_after_linger() {
    local name="$1" token="$2" idle markers
    trap '' HUP
    while :
    do
        sleep "$LINGER"
        lock_box "$name" || return 1
        if ! running "$name" || ! has_idle_token "$name" "$token"
        then
            note "qemubox-$name is stopped or stamped idle again; leaving it"
            unlock_box
            return 0
        fi
        idle=$(stat -c %Y "$(box_dir "$name")/idle")
        if markers=$(session_markers "$name")
        then
            if [ -n "$markers" ]
            then
                note "qemubox-$name is busy; leaving it"
            else
                note "no session for ${LINGER}s; powering off qemubox-$name, keeping disk"
                stop_box "$name" || return 1
            fi
            unlock_box
            return 0
        fi
        unlock_box
        if [ $(( $(date +%s) - idle )) -ge $((4 * 3600)) ]
        then
            note "cannot count sessions 4h after the last exit; giving up on qemubox-$name"
            return 1
        fi
        note "cannot count sessions; retrying in ${LINGER}s"
    done
}

linger_box() {
    local dir token
    dir="$(box_dir "$1")"
    token="$$.$(date +%s%N)"
    printf '%s\n' "$token" > "$dir/idle"
    note "last session exited; qemubox-$1 powers off after ${LINGER}s idle"
    (stop_after_linger "$1" "$token") </dev/null >>"$dir/idle.log" 2>&1 9>&- &
}

leave_session() {
    local rc=$? left err
    trap - EXIT HUP TERM INT
    if [ -n "$session_pid" ]
    then
        kill "$session_pid" 2>/dev/null || true
        wait "$session_pid" 2>/dev/null || true
    fi
    if [ -z "$locked" ] && ! lock_box "$name"
    then
        exit 1
    fi
    if ! running "$name"
    then
        :
    elif [ -z "$sid" ]
    then
        [ -z "$booted" ] || stop_box "$name" || rc=1
    elif ! err=$(ssh_plain_box "$name" "sudo rm -f /run/qemubox/sess/$sid" 2>&1)
    then
        if wait_stopped "$name" 15
        then
            note "qemubox-$name powered off during the session"
        else
            [ -z "$err" ] || echo "$err" >&2
            note "cannot remove session marker; keeping qemubox-$name $(run_state "$name")"
            rc=1
        fi
    elif ! left=$(session_markers "$name")
    then
        note "cannot count sessions; keeping qemubox-$name running"
        rc=1
    elif [ -z "$left" ] && [ "$LINGER" -gt 0 ]
    then
        linger_box "$name"
    elif [ -z "$left" ]
    then
        note "last session exited; powering off qemubox-$name, keeping disk"
        stop_box "$name" || rc=1
    fi
    unlock_box
    exit "$rc"
}

enter_session() {
    trap leave_session EXIT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    trap 'exit 130' INT
    start_box "$name"
    sid=$$
    ssh_plain_box "$name" "sudo mkdir -p /run/qemubox/sess && sudo touch /run/qemubox/sess/$sid"
    unlock_box
}

ssh_opts() {
    local dir
    dir="$(box_dir "$1")"
    ssh_opts=(-i "$dir/key" -p "$(port_for "$1")" \
        -o ConnectTimeout=3 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
        -o BatchMode=yes -o LogLevel=ERROR \
        -o UserKnownHostsFile="$dir/known_hosts" \
        -o StrictHostKeyChecking=accept-new)
}

ssh_box() {
    name="$(box_name "$1")"
    shift
    ssh_opts "$name"
    agent=()
    [ -n "$ssh_agent" ] && agent=(-A)
    gpg=()
    [ -n "$gpg_sock" ] && gpg=(-o StreamLocalBindUnlink=yes -R "$GUEST_HOME/.gnupg/S.gpg-agent:$gpg_sock")
    docker=()
    [ -n "$docker_sock" ] && docker=(-R "$docker_remote:$docker_sock")
    exec ssh "${ssh_opts[@]}" -o ExitOnForwardFailure=yes \
        "${agent[@]}" "${gpg[@]}" "${docker[@]}" \
        "$GUEST_USER@127.0.0.1" "$@"
}

ssh_plain_box() {
    local name
    name="$(box_name "$1")"
    shift
    ssh_opts "$name"
    ssh "${ssh_opts[@]}" "$GUEST_USER@127.0.0.1" "$@"
}

ssh_stream_box() {
    if [ -t 2 ]; then
        ssh_plain_box "$@" 2>&1 | sed $'s/^/\033[2m> \033[0m/' >&2
    else
        ssh_plain_box "$@"
    fi
}

quote() {
    printf "%q" "$1"
}

add_mount() {
    src="$1"
    dest="$2"
    mode="$3"
    [ -e "$src" ] || {
        [ "${4:-optional}" = optional ] && return 0
        echo "Missing mount source: $src" >&2
        return 1
    }
    case "$src" in
        *,*) echo "Cannot 9p-mount path containing comma: $src" >&2; exit 2 ;;
    esac
    tag="qbx${#mount_tags[@]}"
    mount_tags+=("$tag")
    mount_srcs+=("$src")
    mount_dests+=("$dest")
    mount_modes+=("$mode")
}

stage_host_cfg() {
    cfg="$1"
    mkdir -p "$cfg/.gnupg"
    chmod 700 "$cfg"
    for rel in "${host_cfg_files[@]}"; do
        if [ -f "$HOME/$rel" ]; then
            cp -pL "$HOME/$rel" "$cfg/$rel"
        else
            rm -f "$cfg/$rel"
        fi
    done
}

qemu_mount_args() {
    for i in "${!mount_tags[@]}"; do
        ro=""
        [ "${mount_modes[$i]}" = ro ] && ro=",readonly=on"
        printf '%s\n' -virtfs
        printf 'local,path=%s,mount_tag=%s,security_model=none%s\n' \
            "${mount_srcs[$i]}" "${mount_tags[$i]}" "$ro"
    done
}

stage_ephemeral() {
    local output="$1" d name
    local mode=tmpfs find_expr=()
    [ -z "$eph_no_tmpfs" ] || mode=disk
    printf '%s\0' "$mode" > "$output"
    [ -z "$persist_builds" ] || return 0
    for name in "${EPHEMERAL_DIRS[@]}"
    do
        [ "${#find_expr[@]}" -eq 0 ] || find_expr+=(-o)
        find_expr+=(-name "$name")
    done
    for d in "${dirs[@]}"
    do
        find "$d" -maxdepth 4 -type d \
            \( "${find_expr[@]}" \) -prune -print0 >> "$output"
    done
}

setup_guest_tmp() {
    ssh_stream_box "$1" 'set -e
sudo mount -t tmpfs -o rw,exec,mode=1777,size=75% tmpfs /tmp
sudo install -d -o "$(id -u)" -g "$(id -g)" /tmp/cargo-target'
}

setup_guest_builds() {
    ssh_stream_box "$1" \
        "sudo bash -s -- $(id -u) $(id -g) /run/qemubox/config/ephemeral" <<'EOF'
set -Eeuo pipefail
uid=$1
gid=$2
{
    IFS= read -r -d '' mode
    case "$mode" in
        tmpfs) root=/tmp/qemubox-builds ;;
        disk) root=/var/lib/qemubox/builds ;;
        *) echo "Invalid build mount mode: $mode" >&2; exit 1 ;;
    esac
    while IFS= read -r -d '' path
    do
        mkdir -p -- "$path"
        key=$(realpath -e -- "$path" | sha256sum)
        backing="$root/${key%% *}"
        mkdir -p "$backing"
        chown "$uid:$gid" "$backing"
        mount --bind "$backing" "$path"
    done
} < "$3"
EOF
}

qemu_acceleration() {
    local device="${1:-/dev/kvm}"
    accel=()
    cpu=max
    if [ -r "$device" ] && [ -w "$device" ]
    then
        accel=(-enable-kvm)
        cpu=host
    fi
}

setup_guest_limits() {
    ssh_plain_box "$1" "sudo bash -s -- $(quote "$GUEST_USER")" <<'EOF'
set -Eeuo pipefail
mkdir -p /etc/security/limits.d
printf '%s - nice -20\n%s - rtprio 99\n%s - memlock unlimited\n' \
    "$1" "$1" "$1" > /etc/security/limits.d/90-qemubox.conf
EOF
}

sync_guest_clock() {
    ssh_plain_box "$1" \
        "sudo systemctl disable --now --quiet systemd-timesyncd.service"
    ssh_plain_box "$1" "sudo date -u -s $(quote "@$(date +%s.%N)") >/dev/null"
}

setup_guest_sessions() {
    [ -z "$untrusted" ] || return 0
    ssh_plain_box "$1" "mkdir -p ~/.claude/sessions && sudo mount -t tmpfs -o rw,mode=0700,uid=$(id -u),gid=$(id -g) tmpfs ~/.claude/sessions"
}

setup_mount_path() {
    ssh_plain_box "$1" \
        "sudo bash -s -- $(id -u) $(id -g) $(quote "$2")" <<'EOF'
set -Eeuo pipefail
uid=$1
gid=$2
path=$3
missing=()
while [ ! -d "$path" ]
do
    missing+=("$path")
    path=$(dirname "$path")
done
for ((i=${#missing[@]}-1; i>=0; i--))
do
    install -d -m 755 -o "$uid" -g "$gid" -- "${missing[$i]}"
done
EOF
}

session_tty() {
    tty=()
    if [ -t 0 ] && [ -t 1 ]
    then
        tty=(-t)
    fi
}

start_box() {
    name="$(box_name "$1")"
    missing_deps
    dir="$(box_dir "$name")"
    mkdir -p "$dir"
    lock_box "$name"
    check_trust "$name" || return 1
    port="$(port_for "$name")"
    if running "$name"
    then
        image_id=$(cat "$dir/image-id")
        [ -s "$ROOT/base/$image_id.qcow2" ] || {
            echo "Missing base $image_id; run qemubox rm $name" >&2
            return 1
        }
        note "waiting for running VM qemubox-$name"
        wait_ready "$name" session
        booted=""
        return
    fi
    assemble_mounts
    ensure_box "$name"
    rm -f "$dir/ready" "$dir/known_hosts"
    for ((attempt=0; attempt<100; attempt++))
    do
        (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || break
        port=$(( (port - 10000 + 1) % 50000 + 10000 ))
    done
    [ "$attempt" -lt 100 ] || { echo "No free SSH port for $name" >&2; return 1; }
    echo "$port" > "$dir/port"
    qemu_acceleration
    restrict=",restrict=on"
    [ -n "$network" ] && restrict=""
    if [ "${#accel[@]}" -gt 0 ]; then
        note "starting qemubox-$name with KVM acceleration"
    else
        note "starting qemubox-$name without KVM; software emulation is slower"
    fi
    if [ -n "$network" ]; then
        note "guest network: outbound enabled"
    else
        note "guest network: restricted; only host SSH forwarding is open"
    fi
    mapfile -t mounts < <(qemu_mount_args)
    (cd "$dir" && "$QEMU" "${accel[@]}" \
        -cpu "$cpu" -machine q35 -rtc base=utc,clock=host -m "$MEM" -smp "$CPUS" \
        -device virtio-balloon-pci,free-page-reporting=on \
        -drive "file=$dir/disk.qcow2,if=virtio,format=qcow2,discard=unmap,detect-zeroes=unmap" \
        -kernel "$ROOT/base/$image_id.vmlinuz" -initrd "$ROOT/base/$image_id.initrd" \
        -append "root=/dev/vda rw console=ttyS0 noresume loglevel=5" \
        -virtfs "local,path=$dir/config,mount_tag=qbxcfg,security_model=none,readonly=on" \
        "${mounts[@]}" \
        -nic "user,model=virtio$restrict,hostfwd=tcp:127.0.0.1:$port-:22" \
        -serial "file:$dir/serial.log" \
        -qmp "unix:qmp,server=on,wait=off" \
        -display none -daemonize -pidfile "$dir/pid" 9>&-)
    booted=1
    note "waiting for guest setup on 127.0.0.1:$port"
    wait_ready "$name" boot
    ssh_plain_box "$name" 'sudo rm -f /run/qemubox/ready'
    setup_guest_tmp "$name"
    mount_host_paths "$name"
    setup_guest_builds "$name"
    setup_guest_runtime "$name"
    setup_guest_sessions "$name"
    setup_guest_limits "$name"
    sync_guest_clock "$name"
    ssh_plain_box "$name" 'sudo mkdir -p /run/qemubox/sess && sudo touch /run/qemubox/ready'
    touch "$dir/ready"
}

detect_gpg() {
    gpg_sock="$(gpgconf --list-dirs agent-socket 2>/dev/null || true)"
    if [ -S "$gpg_sock" ] && gpg-connect-agent /bye >/dev/null 2>&1; then
        note "forwarding gpg-agent into qemubox-$name over SSH"
        return
    fi
    if [ -n "$gpg_sock" ]; then
        note "-K: host gpg-agent not answering ($gpg_sock); run 'gpgconf --launch gpg-agent' -- not forwarding"
    fi
    gpg_sock=""
}

mount_host_paths() {
    name="$1"
    note "mounting host paths into qemubox-$name with 9p"
    ssh_plain_box "$name" 'sudo modprobe -a 9p 9pnet_virtio'
    ssh_plain_box "$name" 'grep -qw 9p /proc/filesystems' || {
        note "guest kernel lacks 9p filesystem support; rebuild with qemubox build-base --force"
        exit 1
    }
    for i in "${!mount_tags[@]}"; do
        tag="${mount_tags[$i]}"
        dest="${mount_dests[$i]}"
        opts="trans=virtio,version=9p2000.L,msize=104857600"
        [ "${mount_modes[$i]}" = ro ] && opts="$opts,ro"
        setup_mount_path "$name" "$dest"
        ssh_plain_box "$name" "mountpoint -q $(quote "$dest") || sudo mount -t 9p -o $(quote "$opts") $(quote "$tag") $(quote "$dest")"
    done
    for dest in "${dirs[@]}"
    do
        ssh_plain_box "$name" "if [ -f $(quote "$dest/.qemuboxrc") ]; then sudo mount --bind /dev/null $(quote "$dest/.qemuboxrc") && sudo mount -o remount,bind,ro $(quote "$dest/.qemuboxrc"); fi"
    done
}

setup_guest_runtime() {
    name="$1"
    settings='--settings '\''{"sandbox":{"enabled":false}}'\'''
    wrapper_edit="s/--dangerously-skip-permissions \"/--dangerously-skip-permissions $settings \"/"
    ssh_plain_box "$name" "sudo sed -i $(quote "$wrapper_edit") /usr/local/bin/claude"
    ssh_stream_box "$name" 'set -e
mkdir -p ~/.docker/run ~/.gnupg
chmod 700 ~/.gnupg
sudo tee /usr/local/bin/codex >/dev/null <<'\''EOF'\''
#!/bin/sh
exec /opt/dev-tools/bun/bin/codex --dangerously-bypass-approvals-and-sandbox "$@"
EOF
sudo chmod 755 /usr/local/bin/codex'
    guest_note "$HOSTNAME" "$(box_dir "$name")/config/ephemeral" | ssh_plain_box "$name" 'sudo mkdir -p /etc/claude-code && sudo tee /etc/claude-code/CLAUDE.md >/dev/null'
    ssh_stream_box "$name" 'set -e
if [ -f /mnt/qemubox-home/.claude.json ]
then
    ln -sf /mnt/qemubox-home/.claude.json /tmp/host-claude.json
fi
for rel in .gitconfig .gnupg/pubring.kbx .gnupg/pubring.gpg
do
    if [ -f "/mnt/qemubox-home/$rel" ]
    then
        ln -sf "/mnt/qemubox-home/$rel" "$HOME/$rel"
    fi
done
if [ -f /mnt/qemubox-history/history ]
then
    for rel in .bash_history .zsh_history
    do
        touch "$HOME/$rel"
        sudo mount --bind /mnt/qemubox-history/history "$HOME/$rel"
    done
fi'
}

wait_stopped() {
    local n
    for ((n = 0; n < $2; n++))
    do
        running "$1" || return 0
        sleep 1
    done
    return 1
}

stop_box() {
    local mode="${2:-graceful}" state
    name="$(box_name "$1")"
    running "$name" || return 0
    dir="$(box_dir "$name")"
    pid="$(cat "$dir/pid")"
    if [ "$mode" = graceful ]
    then
        state=$(run_state "$name")
        if [[ "$state" = paused* ]]
        then
            note "resuming qemubox-$name ($state) for its shutdown"
            qmp_box "$name" cont >/dev/null ||
                note "cannot resume qemubox-$name over QMP"
        fi
        ssh_plain_box "$name" sudo fstrim / >/dev/null ||
            note "cannot trim the disk of qemubox-$name"
        ssh_plain_box "$name" sudo poweroff >/dev/null 2>&1 ||
            note "poweroff SSH closed; waiting for qemu"
        note "waiting up to 90s for guest shutdown of qemubox-$name"
        wait_stopped "$name" 90 || mode=force
    fi
    if [ "$mode" = force ]
    then
        if [ -S "$dir/qmp" ]
        then
            note "sending quit over QMP to qemu PID $pid; waiting up to 10s"
            qmp_box "$name" quit >/dev/null || kill "$pid" 2>/dev/null || true
        else
            note "sending SIGTERM to qemu PID $pid; waiting up to 10s"
            kill "$pid" 2>/dev/null || true
        fi
        wait_stopped "$name" 10 || mode=kill
    fi
    if [ "$mode" = kill ]
    then
        note "sending SIGKILL to qemu PID $pid; waiting up to 5s"
        kill -9 "$pid" 2>/dev/null || true
        wait_stopped "$name" 5 || {
            echo "VM still running as PID $pid" >&2
            return 1
        }
    fi
    rm -f "$dir/pid" "$dir/ready"
    touch "$dir/stopped"
}

remove_box() {
    local name dir rel
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    stop_box "$name" || { echo "qemubox-$name still running; not removing its files" >&2; return 1; }
    rm -f "$dir/config/identity" "$dir/config/authorized_keys" \
        "$dir/config/ephemeral" "$dir/trust" "$dir/image-id" "$dir/ready" "$dir/stopped"
    if [ -d "$dir/config" ]
    then
        rmdir "$dir/config"
    fi
    rm -f "$dir/disk.qcow2"
    rm -f "$dir/serial.log" "$dir/pid" "$dir/known_hosts" "$dir/key" "$dir/key.pub" "$dir/.lock" "$dir/port" "$dir/qmp"
    rm -f "$dir/idle" "$dir/idle.log"
    for rel in "${host_cfg_files[@]}"; do rm -f "$dir/hostcfg/$rel"; done
    rm -f "$dir/history/history"
    if [ -d "$dir/history" ]
    then
        rmdir "$dir/history"
    fi
    if [ -d "$dir/hostcfg" ]
    then
        rmdir "$dir/hostcfg/.gnupg" "$dir/hostcfg" || return 1
    fi
    rmdir "$dir" || return 1
    echo "removed qemubox-$name"
}

build_base() (
    set -Eeuo pipefail
    force="${1:-}"
    source_dir="${QEMUBOX_SOURCE:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")}"
    [ -f "$source_dir/dockbox/Dockerfile" ] || {
        echo "Set QEMUBOX_SOURCE to the tools repo containing dockbox/Dockerfile" >&2
        exit 1
    }
    read -r -a docker_cmd <<< "${QEMUBOX_DOCKER:-docker}"
    PATH="$PATH:/usr/sbin:/sbin"
    missing_deps "${docker_cmd[0]}" bsdtar mke2fs qemu-img tar flock
    tmp=$(mktemp -d)
    trap 'rm -f "$tmp/probe.tar" "$tmp/probe.raw" "$tmp/probe.log"; rmdir "$tmp"' EXIT
    tar -cf "$tmp/probe.tar" --files-from /dev/null
    if ! mke2fs -q -t ext4 -F -d "$tmp/probe.tar" "$tmp/probe.raw" 8M >"$tmp/probe.log" 2>&1
    then
        cat "$tmp/probe.log" >&2
        echo "Missing: mke2fs with -d tarball support (the build needs a mke2fs -d that accepts a tarball)" >&2
        exit 1
    fi
    rm -f "$tmp/probe.tar" "$tmp/probe.raw" "$tmp/probe.log"
    mkdir -p "$ROOT/base"
    exec 8>"$ROOT/base/.lock"
    flock 8
    build_args=()
    [ -z "$force" ] || build_args+=(--build-arg "AGENTS_CACHEBUST=$(date +%s)")
    "${docker_cmd[@]}" build --force-rm --target vm -t qemubox-vm \
        "${build_args[@]}" -f "$source_dir/dockbox/Dockerfile" "$source_dir"
    image_id=$("${docker_cmd[@]}" image inspect -f '{{.Id}}' qemubox-vm)
    image_id=${image_id#sha256:}
    [[ "$image_id" =~ ^[a-f0-9]{64}$ ]]
    base="$ROOT/base/$image_id"
    if [ ! -s "$base.qcow2" ] || [ ! -s "$base.vmlinuz" ] || [ ! -s "$base.initrd" ]
    then
        container=""
        cleanup_image() {
            rc=$?
            trap - EXIT
            if [ -n "$container" ]
            then
                "${docker_cmd[@]}" rm "$container" >/dev/null || rc=1
            fi
            rm -f "$tmp/export.tar" "$tmp/rootfs.tar" "$tmp/rootfs.raw" \
                "$base.qcow2.tmp" "$base.vmlinuz.tmp" "$base.initrd.tmp"
            rmdir "$tmp"
            exit "$rc"
        }
        trap cleanup_image EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        note "exporting VM rootfs: $image_id"
        container=$("${docker_cmd[@]}" create "$image_id")
        "${docker_cmd[@]}" export -o "$tmp/export.tar" "$container"
        "${docker_cmd[@]}" rm "$container" >/dev/null
        container=""
        bsdtar -cf "$tmp/rootfs.tar" --exclude=.dockerenv "@$tmp/export.tar"
        rm "$tmp/export.tar"
        kernel=$(tar -tf "$tmp/rootfs.tar" | sed -n 's,^boot/vmlinuz-,,p' | sort -V | tail -1)
        [ -n "$kernel" ]
        tar -xOf "$tmp/rootfs.tar" "boot/vmlinuz-$kernel" > "$base.vmlinuz.tmp"
        tar -xOf "$tmp/rootfs.tar" "boot/initrd.img-$kernel" > "$base.initrd.tmp"
        note "creating ext4 base in /tmp"
        mke2fs -q -t ext4 -F -d "$tmp/rootfs.tar" "$tmp/rootfs.raw" 20G
        note "converting base to qcow2"
        qemu-img convert -c -O qcow2 -o compression_type=zstd "$tmp/rootfs.raw" "$base.qcow2.tmp"
        mv "$base.vmlinuz.tmp" "$base.vmlinuz"
        mv "$base.initrd.tmp" "$base.initrd"
        mv "$base.qcow2.tmp" "$base.qcow2"
    fi
    printf '%s\n' "$image_id" > "$ROOT/base/current"
    note "base ready: $base.qcow2"
)

list_boxes() {
    local dir name state use ram disk markers found=""
    mkdir -p "$ROOT"
    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue
        [ "${dir##*/}" = base ] && continue
        [ -n "$found" ] || printf "NAME\tSTATUS\tUSE\tRAM\tDISK\tPATH\n"
        found=1
        name="${dir##*/}"
        use=idle; ram=0
        lock_box "$name" || return 1
        state=$(run_state "$name")
        if [ "$state" != stopped ]
        then
            ram=$(ps -o rss= -p "$(cat "$dir/pid")") || ram="?"
            if [ "$state" != running ]
            then
                use="?"
            elif markers=$(session_markers "$name")
            then
                [ -z "$markers" ] || use=busy
            else
                use="?"
            fi
        fi
        disk=0
        if [ -f "$dir/disk.qcow2" ]
        then
            disk=$(du -k "$dir/disk.qcow2" | cut -f1) || disk="?"
        fi
        unlock_box
        printf "qemubox-%s\t%s\t%s\t%s\t%s\t%s\n" "$name" "$state" "$use" \
            "$(human_kib "${ram// /}")" "$(human_kib "$disk")" "$dir"
    done
    [ -n "$found" ] || echo "no qemubox VMs"
}

human_kib() {
    case $1 in
        *[!0-9]*|"") echo "$1" ;;
        *) numfmt --from-unit=1024 --to=iec "$1" ;;
    esac
}

match_boxes() {
    local dir name target matched=""
    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        [ "$name" = base ] && continue
        rm_matches "$name" "$1" || continue
        matched=1
        for target in "${targets[@]}"
        do
            [ "$target" != "$name" ] || continue 2
        done
        targets+=("$name")
    done
    [ -n "$matched" ]
}

stopped_boxes() {
    local cutoff dir name ts
    cutoff=$(($(date +%s) - 10#$1 * 3600))
    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        [ "$name" = base ] && continue
        running "$name" && continue
        ts=$(stat -c %Y "$dir/stopped" 2>/dev/null || stat -c %Y "$dir") || continue
        [ "$ts" -lt "$cutoff" ] || continue
        echo "qemubox-$name"
        targets+=("$name")
    done
}

remove_boxes() {
    local pat name rc=0 hours="" targets=()
    [ "$#" -gt 0 ] || {
        echo "qemubox rm: a name or glob is required (-a for all)" >&2
        return 2
    }
    if [ "$1" = --stopped ]
    then
        hours=${2:-}
        [[ "$#" -eq 2 && "$hours" =~ ^[0-9]+$ ]] || {
            echo "qemubox rm: --stopped takes whole hours and nothing else" >&2
            return 2
        }
        stopped_boxes "$hours"
        set --
    fi
    for pat in "$@"
    do
        case "$pat" in
            -a|--all) pat='*' ;;
            -*) echo "qemubox rm: unknown option '$pat'" >&2; return 2 ;;
        esac
        match_boxes "$pat" || { echo "qemubox rm: no match for '$pat'" >&2; rc=1; }
    done
    for name in "${targets[@]}"
    do
        lock_box "$name" || { rc=1; continue; }
        if [ -n "$hours" ] && running "$name"
        then
            note "qemubox-$name is running again; keeping it"
        else
            remove_box "$name" || rc=1
        fi
        unlock_box
    done
    return "$rc"
}

stop_boxes() {
    local pat name rc=0 mode=graceful named="" targets=()
    for pat in "$@"
    do
        case "$pat" in
            -f|--force) mode=force; continue ;;
            -a|--all) pat='*' ;;
            -*) echo "qemubox stop: unknown option '$pat'" >&2; return 2 ;;
        esac
        named=1
        match_boxes "$pat" || { echo "qemubox stop: no match for '$pat'" >&2; rc=1; }
    done
    [ -n "$named" ] || {
        echo "qemubox stop: a name or glob is required (-a for all, -f skips the guest shutdown)" >&2
        return 2
    }
    for name in "${targets[@]}"
    do
        lock_box "$name" || { rc=1; continue; }
        if ! running "$name"
        then
            note "qemubox-$name is not running"
        elif stop_box "$name" "$mode"
        then
            echo "stopped qemubox-$name"
        else
            rc=1
        fi
        unlock_box
    done
    return "$rc"
}

prune_boxes() {
    local grace dir name ts markers rc=0
    grace=$(($(date +%s) - 4 * 3600))
    for dir in "$ROOT"/*
    do
        [ -d "$dir" ] || continue
        name=${dir##*/}
        [ "$name" = base ] && continue
        lock_box "$name" || { rc=1; continue; }
        if running "$name"
        then
            ts=$(stat -c %Y "$dir/ready") || { unlock_box; continue; }
            if [ "$ts" -le "$grace" ]
            then
                if markers=$(session_markers "$name")
                then
                    [ -n "$markers" ] || stop_box "$name" || rc=1
                else
                    note "cannot count sessions; keeping qemubox-$name running"
                    rc=1
                fi
            fi
        fi
        unlock_box
    done
    prune_bases || rc=1
    return "$rc"
}

prune_bases() (
    [ -d "$ROOT/base" ] || exit 0
    exec 8>"$ROOT/base/.lock"
    flock 8
    current=$(cat "$ROOT/base/current") || exit 1
    for base in "$ROOT/base/"*.qcow2
    do
        [ -f "$base" ] || continue
        image_id=${base##*/}
        image_id=${image_id%.qcow2}
        [ "$image_id" != "$current" ] || continue
        for ref in "$ROOT"/*/image-id
        do
            [ -f "$ref" ] || continue
            ref_id=$(cat "$ref") || exit 1
            [ "$ref_id" != "$image_id" ] || continue 2
        done
        rm -f "$base" "$ROOT/base/$image_id.vmlinuz" "$ROOT/base/$image_id.initrd" || exit 1
        note "removed unused base $image_id"
    done
)

status_box() {
    name="$(box_name "$1")"
    dir="$(box_dir "$name")"
    [ -d "$dir" ] || { echo "no qemubox VM named '$name'" >&2; exit 1; }
    port="$(port_for "$name")"
    proc=$(run_state "$name")
    ssh_state=closed
    (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && ssh_state=open
    boot=pending
    [ -f "$dir/serial.log" ] && grep -qiE 'qemubox: ready' "$dir/serial.log" && boot=ready
    printf "qemubox-%s\tprocess=%s\tssh=%s\tboot=%s\tport=%s\n" \
        "$name" "$proc" "$ssh_state" "$boot" "$port"
}

add_env() {
    var="$1"
    case "$var" in
        ""|*[!A-Za-z0-9_]*|[0-9]*)
            echo "Invalid env var: $var" >&2
            exit 2 ;;
    esac
    val="${!var-}"
    envs+=("$var=$val")
}

copy_arg() {
    path="$1"
    case "$path" in
        *:rw) path="${path%:rw}" ;;
        *:ro) path="${path%:ro}" ;;
    esac
    case "$path" in
        /*|./*|.|~*) printf '%s' "$path" ;;
        *) echo "Invalid -v path: $1" >&2; exit 2 ;;
    esac
}

apply_flag() {
    case "$1" in
        n)
            case "$2" in
                ""|.|..|base|.build|.locks|*/*)
                    echo "qemubox: invalid -n name: '$2'" >&2; exit 2 ;;
            esac
            name_override="$2" ;;
        d|x) entrypoint="$2"; entrypoint_explicit=1 ;;
        e) add_env "$2" ;;
        v)
            extra_dirs+=("$(copy_arg "$2")")
            case "$2" in
                *:rw) extra_modes+=(rw) ;;
                *) extra_modes+=(ro) ;;
            esac ;;
        T) tmp_session=1 ;;
        N) new_session=1 ;;
        H) network="" ;;
        U) untrusted=1; network="" ;;
        A) ssh_agent=1 ;;
        D)
            if [ -S /var/run/docker.sock ]; then
                docker_sock=/var/run/docker.sock
                docker_remote="$GUEST_HOME/.docker/run/docker.sock"
                envs+=("DOCKER_HOST=unix://$docker_remote")
            else
                warnings+=("-D ignored: /var/run/docker.sock is not available")
            fi ;;
        K) gpg_forward=1 ;;
        S) warnings+=("-S ignored: qemubox guest user already has passwordless sudo") ;;
        P) persist_builds=1 ;;
        B) eph_no_tmpfs=1 ;;
        g)
            if [ -n "${GH_TOKEN:-}" ]
            then
                envs+=("GH_TOKEN=$GH_TOKEN")
            fi
            if [ -n "${GITHUB_TOKEN:-}" ]
            then
                envs+=("GITHUB_TOKEN=$GITHUB_TOKEN")
            fi ;;
        G) gcloud_creds=1 ;;
        *) usage >&2; exit 2 ;;
    esac
}

read_rc() {
    rc_tokens=()
    [[ -f "$1" ]] || return 0
    while IFS= read -r line || [ -n "$line" ]
    do
        [[ -z "$line" || "$line" == \#* ]] && continue
        read -ra words <<< "$line"
        rc_tokens+=("${words[@]}")
    done < "$1"
}

project_rc() {
    [ ! "$1/.qemuboxrc" -ef "$HOME/.qemuboxrc" ] || return 0
    read_rc "$1/.qemuboxrc"
    OPTIND=1
    while getopts ":n:d:x:e:v:HKUADgGPBTSN" opt "${rc_tokens[@]}"
    do
        case "$opt" in
            A|D|K|S|T|n|d|x)
                echo "qemubox: ignoring -$opt in project .qemuboxrc" \
                    "(use ~/.qemuboxrc)" >&2 ;;
            *) apply_flag "$opt" "${OPTARG:-}" ;;
        esac
    done
}

resume_session() {
    local slug="${primary//[^A-Za-z0-9]/-}" sessions
    [ -z "$new_session" ] || return 0
    [ "${cmd[0]}" = claude ] || return 0
    sessions=("$HOME/.claude/projects/$slug/"*.jsonl)
    if [ -f "${sessions[0]}" ]
    then
        cmd=(claude --resume "${cmd[@]:1}")
    fi
}

tool_cmd() {
    local opts=() arg has_model=""
    case "$1" in
        claude) cmd=(claude); opts=(--model claude-opus-5-5 --effort xhigh) ;;
        codex) cmd=(codex); opts=(-m gpt-6.1-sol -c model_reasoning_effort=xhigh) ;;
        haiku) cmd=(claude); opts=(--model claude-haiku-4-5-20251001) ;;
        sonnet) cmd=(claude); opts=(--model claude-sonnet-5-5 --effort high) ;;
        opus) cmd=(claude); opts=(--model claude-opus-5-5 --effort xhigh) ;;
        fable) cmd=(claude); opts=(--model claude-fable-5-1) ;;
        gpt) cmd=(codex); opts=(-m gpt-6-astra) ;;
        mini) cmd=(codex); opts=(-m gpt-5.4-mini) ;;
        spark) cmd=(codex); opts=(-m gpt-5.3-codex-spark) ;;
        sh|bash) cmd=(bash -l) ;;
        zsh) cmd=(zsh -l) ;;
        *) cmd=("$1") ;;
    esac
    for arg in "${args[@]}"; do
        case "$arg" in
            -m|--model|--model=*) has_model=1 ;;
        esac
    done
    [ -n "$has_model" ] || cmd+=("${opts[@]}")
}

rm_matches() {
    local pat="${2#qemubox-}"
    [ -n "$pat" ] || return 1
    case "$pat" in
        *[*?]*) [[ "$1" == $pat ]] ;;
        *) [ "$1" = "$pat" ] ;;
    esac
}

apply_untrusted() {
    local dropped="" e kept=()
    [ -n "$ssh_agent$docker_sock$gpg_forward$gcloud_creds" ] && dropped=1
    ssh_agent=""; docker_sock=""; docker_remote=""; gpg_forward=""; gcloud_creds=""
    for e in "${envs[@]}"; do
        case " GH_TOKEN GITHUB_TOKEN DOCKER_HOST ${agent_tokens[*]} " in
            *" ${e%%=*} "*) dropped=1 ;;
            *) kept+=("$e") ;;
        esac
    done
    envs=("${kept[@]}")
    [ -n "$dropped" ] && warnings+=("-U: dropping credential-forwarding flags (-A/-D/-K/-G/-g) and agent tokens; untrusted mode injects nothing")
    case "${cmd[0]:-}" in
        claude|codex)
            warnings+=("-U: no credentials injected; the agent cannot authenticate -- use bash/build/test") ;;
    esac
}

send_envs() {
    local e
    for e in "${envs[@]}"
    do
        printf 'export %s=%q\n' "${e%%=*}" "${e#*=}"
    done | ssh_plain_box "$name" "umask 077 && cat > $env_file"
}

assemble_mounts() {
    local d i dir gc gcr host_cfg history_dir gitmounts=()
    if [ -z "$untrusted" ]; then
        host_cfg="$(box_dir "$name")/hostcfg"
        stage_host_cfg "$host_cfg"
        add_mount "$host_cfg" "/mnt/qemubox-home" ro
        for d in .claude .codex .agents; do
            add_mount "$HOME/$d" "$HOME/$d" rw
        done
        add_mount "$HOME/.claude/plugins" "$HOME/.claude/plugins" ro
        history_dir="$(box_dir "$name")/history"
        mkdir -p "$history_dir"
        chmod 700 "$history_dir"
        [ -f "$HOME/.dockbox_history" ] || touch "$HOME/.dockbox_history"
        if [ ! "$HOME/.dockbox_history" -ef "$history_dir/history" ]
        then
            ln -fL "$HOME/.dockbox_history" "$history_dir/history"
        fi
        add_mount "$history_dir" /mnt/qemubox-history rw
    fi
    if [ -n "$gcloud_creds" ]
    then
        add_mount "$HOME/.config/gcloud" "$GUEST_HOME/.config/gcloud" ro required || return 1
    fi
    for dir in "${dirs[@]}"
    do
        add_mount "$dir" "$dir" rw
        gc=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
        [[ "$gc" == "$dir" || "$gc" == "$dir"/* ]] && continue
        case " ${gitmounts[*]} " in *" $gc "*) continue ;; esac
        if gcr=$(realpath -e "$gc")
        then
            gitmounts+=("$gc")
            add_mount "$gcr" "$gc" rw
        else
            echo "qemubox: worktree git dir missing ($gc); repair the .git gitlink" >&2
            return 1
        fi
    done
    for i in "${!extra_dirs[@]}"; do
        dir="$(realpath -e -- "${extra_dirs[$i]}")" || return 1
        add_mount "$dir" "$dir" "${extra_modes[$i]}" required || return 1
    done
    return 0
}

guest_note() {
    local eph=()
    net=off
    [ -n "$network" ] && net=on
    mapfile -d '' -t eph < "$2"
    cat <<EOF
# Environment: qemubox sandbox

You are inside qemubox, a throwaway QEMU VM started from host \`$1\`, not on
the host itself. CLAUDE_SANDBOX=qemubox. The launcher writes this file at boot;
a wrong line here is a qemubox launcher bug.

- Host files are absent unless mounted below. Outbound network: $net.
- Survives the box: the rw mounts below and the guest disk until the box is
  removed. \`~/.claude\` shares the host's config unless -U omits it, so edits
  to shared skills, memory and settings reach the host. NEVER edit a
  \`server-*\` skill here: it describes the host, not this VM.
- The VM powers off once its last session has exited and QEMUBOX_LINGER
  seconds (default 1200) pass with no session. Disk files survive re-entry;
  removing the box deletes its disk. Private tmpfs files, including Claude
  sessions and temporary build files, are lost at power-off.
EOF
    if [ -n "$tmp_session" ]
    then
        cat <<EOF
- No project dir is mounted. The working dir $TMP_WORKDIR is guest tmpfs: its
  files are lost at power-off.
EOF
    fi
    if [ "${eph[0]}" = tmpfs ] && [ "${#eph[@]}" -gt 1 ]
    then
        cat <<EOF
- These dependency dirs are empty box-only mounts. ALWAYS install them here
  before a build or test (\`uv sync\`, \`npm ci\`; \`sudo apt-get install\`
  for a missing system package). NEVER report a check as unrunnable because
  a dependency is missing.
EOF
        printf '  - %s\n' "${eph[@]:1}"
    fi
    cat <<EOF

9p mounts (guest path, mode, host source):
EOF
    for i in "${!mount_dests[@]}"; do
        src="${mount_srcs[$i]}"
        [ "$src" = "${mount_dests[$i]}" ] && src="same path"
        echo "- ${mount_dests[$i]} (${mount_modes[$i]}) <- $src"
    done
}

[ -n "${QEMUBOX_LIB:-}" ] && return 0

case "${1:-}" in
    ls) list_boxes; exit 0 ;;
    status)
        [ -n "${2:-}" ] || { echo "usage: qemubox status <name>" >&2; exit 2; }
        status_box "$2"; exit 0 ;;
    rm) shift; rc=0; remove_boxes "$@" || rc=$?; prune_bases || rc=1; exit "$rc" ;;
    stop) shift; stop_boxes "$@"; exit $? ;;
    prune)
        [ "$#" -eq 1 ] || {
            echo "qemubox prune: takes no argument; use qemubox rm --stopped <hours>" >&2
            exit 2
        }
        prune_boxes; exit $? ;;
    build-base)
        force=""
        case "${2:-}" in
            ""|-f|--force) [ -n "${2:-}" ] && force=1 ;;
            *) echo "unknown build-base option: $2" >&2; exit 2 ;;
        esac
        prune_bases
        build_base "$force"
        prune_bases
        exit 0 ;;
    -h|--help|help) usage; exit 0 ;;
esac

read_rc "$HOME/.qemuboxrc"
set -- "${rc_tokens[@]}" "$@"

_args=()
for a in "$@"; do
    case "$a" in
        --no-ephemeral) persist_builds=1 ;;
        --untrusted) untrusted=1; network="" ;;
        --mount-sensitive) mount_sensitive=1 ;;
        *) _args+=("$a") ;;
    esac
done
set -- "${_args[@]}"

while getopts ":n:d:x:e:v:HKUADgGPBTSN" opt; do
    apply_flag "$opt" "${OPTARG:-}"
done
shift $((OPTIND - 1))

if [ -z "$entrypoint_explicit" ] && [ "$#" -gt 0 ]; then
    case "$1" in
        /*|./*|.|~*) : ;;
        *) entrypoint="$1"; shift ;;
    esac
fi

if [ "$entrypoint" = exec ]; then
    [ "$#" -gt 0 ] || {
        echo "qemubox exec: a command is required" >&2
        exit 2
    }
    cmd=("$@"); set --
fi

for arg in "$@"; do
    case "$arg" in
        /*|./*|.|~*) dirs+=("$(cd "$arg" && pwd)") ;;
        *) args+=("$arg") ;;
    esac
done

if [ -z "$mount_sensitive" ]
then
    for dir in "${dirs[@]}" "${extra_dirs[@]}"
    do
        if is_sensitive "$dir"
        then
            echo "qemubox: refusing to mount sensitive path $dir; pass --mount-sensitive to mount it" >&2
            exit 2
        fi
    done
    if [ -z "$tmp_session" ] && [ "${#dirs[@]}" -eq 0 ] && is_sensitive "$(pwd)"
    then
        warnings+=("$(pwd) is a sensitive path; starting a scratch box as -T does (pass the dir and --mount-sensitive to mount it)")
        tmp_session=1
    fi
fi

if [ -n "$tmp_session" ]
then
    [ "${#dirs[@]}" -eq 0 ] || {
        echo "qemubox: -T mounts no project dir; use -v for a host path" >&2
        exit 2
    }
    primary="$TMP_WORKDIR"
    name_override="${name_override:-$(random_name)}"
    new_session=1
else
    [ "${#dirs[@]}" -gt 0 ] || dirs=("$(pwd)")
    primary="${dirs[-1]}"
    project_rc "$primary"
fi
if [ "$entrypoint" != exec ]
then
    tool_cmd "$entrypoint"
    resume_session
fi
name="$(box_name "${name_override:-${primary##*/}}")"

for var in "${agent_tokens[@]}"
do
    [ -z "${!var:-}" ] || add_env "$var"
done
[ -n "$untrusted" ] && apply_untrusted

[ -n "$gpg_forward" ] && detect_gpg
[[ "$LINGER" =~ ^[0-9]{1,9}$ ]] || {
    echo "qemubox: QEMUBOX_LINGER must be whole seconds, at most 9 digits, got '$LINGER'" >&2
    exit 2
}
enter_session
env_file="/dev/shm/qemubox-env.$sid"
envs=(CLAUDE_SANDBOX=qemubox "${envs[@]}" CARGO_TARGET_DIR=/tmp/cargo-target
    CODEX_SQLITE_HOME=/tmp/codex-sqlite)
send_envs

for warning in "${warnings[@]}"; do
    note "$warning"
done

cd_workdir="cd $(quote "$primary")"
[ -z "$tmp_session" ] || cd_workdir="mkdir -p $(quote "$primary") && $cd_workdir"

remote=""
for arg in "${cmd[@]}" "${args[@]}"; do
    printf -v q "%q" "$arg"
    remote="$remote $q"
done

rc=0
remote=". $env_file && rm -f $env_file && $cd_workdir && exec$remote"
note "running in qemubox-$name:$primary"
session_tty
ssh_box "$name" "${tty[@]}" "$remote" <&0 9>&- &
session_pid=$!
wait "$session_pid" || rc=$?
session_pid=""
exit "$rc"
