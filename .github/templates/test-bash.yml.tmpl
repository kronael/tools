---
name: Test — %%COMPONENT%%

on:
    push:
        paths: %%PATHS%%
    pull_request:
        branches: [master]

jobs:
    test:
        runs-on: ubuntu-latest
        timeout-minutes: %%TIMEOUT%%
        steps:
            - uses: actions/checkout@v4
            - run: make -C %%COMPONENT%% test
            - run: bash tests/drift_test.sh
