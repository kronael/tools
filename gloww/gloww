#!/usr/bin/env bash
# gloww - read markdown with glow, at the terminal's real width.
#
# glow wraps each source line on its own, so a file hard-wrapped at 76
# columns keeps those breaks at any width. mdformat --wrap no rejoins each
# paragraph into one line first, and glow then wraps it to fit.
set -euo pipefail

usage() {
    cat <<'USAGE'
usage: gloww [-w WIDTH] [FILE]

Renders FILE (or stdin) with glow, reflowing paragraphs to the terminal
width. Any further arguments pass through to glow.

  -w WIDTH   wrap at WIDTH columns (default: the terminal width)
  GLOWW_WIDTH  same, as an environment variable
USAGE
}

width=${GLOWW_WIDTH:-}
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi
if [ "${1:-}" = "-w" ]; then
    width=$2
    shift 2
fi
if [ -z "$width" ]; then
    width=$(tput cols 2>/dev/null || echo 80)
fi

if ! command -v glow >/dev/null; then
    echo "gloww: glow is not installed - go install github.com/charmbracelet/glow@latest" >&2
    exit 1
fi

if command -v mdformat >/dev/null; then
    reflow=(mdformat)
elif command -v uvx >/dev/null; then
    reflow=(uvx --with mdformat-frontmatter mdformat)
else
    echo "gloww: needs mdformat or uv - pip install mdformat mdformat-frontmatter" >&2
    exit 1
fi

file=/dev/stdin
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    if [ ! -f "$1" ]; then
        echo "gloww: no such file: $1" >&2
        exit 1
    fi
    file=$1
    shift
fi

pager=()
if [ -t 1 ]; then
    pager=(-p)
    # glow's auto style queries the terminal (OSC 11 + CSI 6n) and eats any
    # keystroke typed while it waits, so the pager then ignores q. An explicit
    # style skips the query; dark is glow's own fallback when no answer comes.
    export GLOW_STYLE=${GLOW_STYLE:-dark}
fi

"${reflow[@]}" --wrap no - < "$file" | glow -w "$width" "${pager[@]}" "$@" -
