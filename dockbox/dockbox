#!/bin/bash
set -euo pipefail

IMAGE="dockbox"
SECCOMP="$HOME/.local/share/dockbox/seccomp.json"
CAPS=(sys_nice ipc_lock sys_ptrace)

EPHEMERAL_DIRS=(node_modules .next .turbo .cache)
# dist/build excluded: build tools do `rm -rf dist` which hits EBUSY on a
# mountpoint. Container writes to host paths for these; use -P to disable
# all ephemeral mounts if you need a completely clean workdir.

MOUNTS=(
    "$HOME/.claude:/home/dockbox/.claude:rw"
    "$HOME/.claude/plugins:/home/dockbox/.claude/plugins:ro"
    "$HOME/.claude/plugins:$HOME/.claude/plugins:ro"
    "$HOME/.claude.json:/tmp/host-claude.json:ro"
    "$HOME/.gitconfig:/home/dockbox/.gitconfig:ro"
    "$HOME/.dockbox_history:/home/dockbox/.zsh_history:rw"
    "$HOME/.codex:/home/dockbox/.codex:rw"
    "/etc/localtime:/etc/localtime:ro"
)

dir_override=""
entrypoint="claude"
entrypoint_explicit=""
network_arg=()
ssh_agent=""
docker_sock=""
grant_sudo=""
gcloud_creds=""
gpg_forward=""
dirs=()
extra_vols=()
extra_env=()
persist_builds=""
eph_no_tmpfs=""
claude_args=()
exec_cmd=()

# Apply one parsed flag. Single source of truth for flag semantics, shared by
# the command line and both rc files.
apply_flag() {
    case "$1" in
        n)
            # Reject traversal/reserved names before they become part of a container name.
            case "$2" in
                ""|.|..|*/*) echo "dockbox: invalid -n name: '$2'" >&2; exit 2 ;;
            esac
            dir_override="$2" ;;
        d|x) entrypoint="$2"; entrypoint_explicit=1 ;;
        e) extra_env+=(-e "$2") ;;
        v) extra_vols+=("$2") ;;
        H) network_arg=(--network host) ;;
        A) ssh_agent=1 ;;
        D) docker_sock=1 ;;
        K) gpg_forward=1 ;;
        S) grant_sudo=1 ;;
        P) persist_builds=1 ;;
        T) eph_no_tmpfs=1 ;;
        g) [[ -n "${GH_TOKEN:-}" ]] && extra_env+=(-e GH_TOKEN)
           [[ -n "${GITHUB_TOKEN:-}" ]] && extra_env+=(-e GITHUB_TOKEN) ;;
        G) gcloud_creds=1 ;;
        *) claude_args+=("-$2") ;;
    esac
    return 0  # never let a falsey last branch (e.g. -g, no token) trip set -e
}

# Decide whether container $1 matches the user's rm name or glob $2. A pattern
# lacking the dockbox- prefix gets it; one that has it is taken literally.
rm_matches() {
    local pat="$2"
    [[ "$pat" == dockbox-* ]] || pat="dockbox-$pat"
    [[ "$1" == $pat ]]
}

# Total the tmpfs rows of `df -k --output=fstype,used,target` on stdin, each
# mount once by target (df resamples it per path on it), printed as M or G.
tmpfs_used() {
    awk '$1 == "tmpfs" {
            target = $0; sub(/^[^ ]+ +[^ ]+ +/, "", target)
            if (!seen[target]++) kb += $2
        }
        END {
            if (kb >= 1048576) printf "%.1fG\n", kb / 1048576
            else printf "%dM\n", kb / 1024
        }'
}

# Classify `docker top` output on stdin (ps -ef columns, CMD from field 8): idle
# when only the docker-init and sleep keepers run, else busy; fails if none run.
box_use() {
    awk '$2 == "PID" { next }
        {
            cmd = $8
            for (i = 9; i <= NF; i++) cmd = cmd " " $i
            n++
            if (cmd != "/sbin/docker-init -- /usr/local/bin/dockbox-init sleep infinity" &&
                cmd != "sleep infinity") busy = 1
        }
        END {
            if (!n) exit 1
            print busy ? "busy" : "idle"
        }'
}

resolver_on() {
    awk -v addr="$1" '{
            l = $4
            sub(/:[0-9]+$/, "", l)
            sub(/%.*$/, "", l)
            if (l == addr || l == "0.0.0.0" || l == "*" || l == "[::]") found = 1
        }
        END { exit !found }'
}

loopback_resolver() {
    awk '$1 == "nameserver" { n++; if ($2 !~ /^(127\.|::1$)/) other = 1 }
        END { exit !(n && !other) }' "$1"
}

# Sourcing with DOCKBOX_LIB=1 loads the helpers above without running the CLI,
# so tests can exercise them directly.
[ -n "${DOCKBOX_LIB:-}" ] && return 0

case "${1:-}" in
    ls)
        {
            printf 'NAMES\tSTATUS\tCREATED\tUSE\tTMPFS\tDISK\n'
            docker container ls -a -s --filter "name=^dockbox-" \
                --format "{{.Names}}\t{{.State}}\t{{.Status}}\t{{.RunningFor}}\t{{.Size}}" \
                | while IFS=$'\t' read -r n state status created size; do
                use="-"
                tmpfs="-"
                [[ "$state" == running ]] && {
                    use=$(docker top "$n" | box_use) || use="?"
                    tmpfs=$(docker exec "$n" sh -c \
                        'set -f; IFS=:; set -- /tmp /tmp/cargo-target /dev/shm
                        for p in $DOCKBOX_EPH_PATHS; do
                            [ -e "$p" ] && set -- "$@" "$p"
                        done
                        df -k --output=fstype,used,target "$@"' \
                        | tmpfs_used) || tmpfs="?"
                }
                printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                    "$n" "$status" "$created" "$use" "$tmpfs" "${size%% (*}"
            done
        } | column -t -s $'\t'
        exit 0 ;;
    rm)
        shift
        [[ $# -eq 0 ]] && { echo "dockbox rm: a name or glob is required (-a / '*' removes all)" >&2; exit 2; }
        patterns=()
        for p in "$@"; do
            case "$p" in
                -a|--all) patterns+=('*') ;;
                -*) echo "dockbox rm: unknown option '$p'" >&2; exit 2 ;;
                *) patterns+=("$p") ;;
            esac
        done
        names=$(docker container ls -a --filter "name=^dockbox-" \
            --format "{{.Names}}")
        rc=0
        targets=()
        for p in "${patterns[@]}"; do
            matched=""
            while read -r n; do
                [[ -z "$n" ]] && continue
                rm_matches "$n" "$p" || continue
                matched=1
                case " ${targets[*]} " in *" $n "*) ;; *) targets+=("$n") ;; esac
            done <<< "$names"
            [[ -z "$matched" ]] && { echo "dockbox rm: no match for '$p'" >&2; rc=1; }
        done
        for n in "${targets[@]}"; do
            if docker rm -f -v "$n" >/dev/null; then
                echo "removed $n"
            else
                rc=1
            fi
        done
        exit "$rc" ;;
    prune)
        hours="${2:-2160}"
        [[ "$hours" =~ ^[0-9]+$ ]] || { echo "dockbox prune: hours must be a whole number, got '$hours'" >&2; exit 2; }
        now=$(date +%s)
        cutoff=$((now - 10#$hours * 3600))
        grace=$((now - 4 * 3600))
        rows=$(docker container ls -a --filter "name=^dockbox-" \
            --format "{{.Names}}\t{{.State}}\t{{.CreatedAt}}")
        rc=0
        while IFS=$'\t' read -r n state created; do
            [[ -z "$n" ]] && continue
            ts=$(date -d "${created% *}" +%s 2>/dev/null) || \
                ts=$(date -j -f "%Y-%m-%d %H:%M:%S %z" "${created% *}" +%s)
            use="-"
            if [[ "$state" == running && "$ts" -le "$grace" ]]; then
                use=$(docker top "$n" | box_use) || use="?"
            fi
            if [[ "$use" == idle || ( "$state" == exited && "$ts" -lt "$cutoff" ) ]]; then
                if docker rm -f -v "$n" >/dev/null; then
                    echo "removed $n"
                else
                    rc=1
                fi
            fi
        done <<< "$rows"
        exit "$rc" ;;
    -h|--help)
        cat <<EOF
Usage: dockbox [options] [tool] [dirs...] [tool-args...]
       dockbox ls | rm <name|glob|-a>... | prune [hours]
       dockbox [options] bash [dirs...]
       dockbox [options] exec <cmd> [args...]

Tools (first positional arg — no leading dash):
    (default)       Claude Code, opus @ xhigh effort — the workhorse
    claude          Claude Code, opus (same as default)
    codex           Codex -m gpt-5.6-sol @ xhigh (no sandbox/approvals)
    haiku           Claude Code --model claude-haiku-4-5-20251001 (fast/cheap)
    sonnet          Claude Code --model claude-sonnet-5-5    (fast workhorse)
    opus            Claude Code --model claude-opus-5-5      (default; xhigh)
    fable           Claude Code --model claude-fable-5-1   (max effort)
    gpt             Codex -m gpt-6-astra        (big)
    mini            Codex -m gpt-5.4-mini        (workhorse)
    spark           Codex -m gpt-5.3-codex-spark (fast/cheap)
    bash|zsh|sh     Interactive login shell (sh is an alias for bash)
    exec <cmd>      Run <cmd> in the box, every later arg passed through
    <any cmd>       Any binary installed in the image

Boxes:
    ls              List boxes: USE busy/idle (idle: safe to rm), TMPFS (RAM), DISK
    rm <name>...    Force-remove boxes and their volumes; globs ok, -a = all
    prune [hours]   Remove idle boxes 4+ h old, exited ones over [hours] old (2160)

Options:
    -n name    Key the container on this name, not the primary dir basename
    -d tool    Explicit tool (same as first-arg tool, useful in scripts)
    -e VAR     Forward env var (e.g. -e GH_TOKEN)
    -v path    Extra mount at same path ro by default; path:rw for read-write
    -P         Persist build dirs (disable default ephemeral overmounts)
    -T         Build-dir overmounts on disk volumes; \$HOME and /tmp stay tmpfs
    -H         Use host network
    -A         Forward SSH agent
    -D         Mount Docker socket
    -K         Forward gpg-agent (commit signing); off by default
    -S         Grant passwordless sudo to the runtime user (apt install at runtime)
    -g         Forward GH_TOKEN / GITHUB_TOKEN (whichever is set)
    -G         Mount ~/.config/gcloud ro (forward gcloud credentials)

Kernel:
    io_uring works: boxes run moby's default seccomp profile plus the
    io_uring syscalls, which make seccomp puts at
        $SECCOMP
    Sessions in a box created with ${CAPS[*]^^} hold them as
    ambient caps, so nice, realtime priorities, mlock and ptrace attach
    work as your user.

Ephemeral builds (default):
    Build artifact dirs found under workdir become fresh empty mounts inside
    the container, owned by the container user, removed with the box.
    Recursive (monorepo workspaces included).

    Container starts as root; dockbox-init registers the host invoker in
    /etc/passwd, chowns \$HOME (/home/dockbox tmpfs) plus every overmount to
    the host UID/GID, then gosu-drops. Image has no baked user — one image
    works for every host UID.

    Two backends pick the overmount type only:
      tmpfs  (default) — kernel tmpfs. RAM-backed.
      volume (-T)      — anonymous Docker volume. Disk-backed.
                         Removed with the box.

    Pass -P / --no-ephemeral to disable both and see host build dirs.

    Names: ${EPHEMERAL_DIRS[*]}
    (dist/build excluded — build tools rm -rf them, hitting EBUSY on a mountpoint)

Examples:
    dockbox                           # current dir, opus @ xhigh (default)
    dockbox ~/wk/project              # mount project, opus
    dockbox haiku ~/wk/project        # drop to haiku for speed/cost
    dockbox codex ~/wk/project        # OpenAI Codex
    dockbox bash                      # interactive shell
    dockbox -n mybox bash             # named shell box
    dockbox ~/wk/p1 ~/wk/p2           # multiple dirs, work in last
    dockbox -v ~/wk/lib               # extra mount ro (default)
    dockbox -v ~/wk/lib:rw            # extra mount rw
    dockbox -P                        # keep host build dirs (no overmount)
    dockbox -T                        # build-dir overmounts on disk volumes
    dockbox -e GH_TOKEN               # forward arbitrary env var
    dockbox -g                        # forward GH/GITHUB token
    dockbox -n mybox .                # custom name
    dockbox bash                      # 2nd session: enters the running box
    dockbox codex                     # enters running box, launches codex

Re-entry: if a dockbox for the project is already running, the command
runs inside that live container (shared HOME, mounts, processes) instead
of starting a new one. Tool/model/effort and env flags (-e, -g) apply to the
session; mount/network flags (-v, -H, -D) don't — they're fixed when the
container is created. Use -n <name> to force a separate, fully-provisioned box.

Mounts: ~/.claude (rw; ~/.claude/sessions is a private tmpfs, so boxes and
        the host never list or message each other's Claude sessions),
        ~/.claude.json (ephemeral), ~/.gitconfig (ro), ~/.dockbox_history (rw)

DNS:    A bridge box gets a resolver listening on the bridge gateway (e.g.
        systemd-resolved with DNSStubListenerExtra=172.17.0.1), which follows
        the host across network changes; without one Docker copies the current
        network's servers into the box once, at creation. -H uses the host's.

Config: ~/.dockboxrc (global) and .dockboxrc in the project dir.
        dockbox flags, one per line, # comments ok. The command line
        overrides ~/.dockboxrc. Project .dockboxrc takes the safe
        subset only — -A/-D/-S are ignored there (use ~/.dockboxrc).
EOF
        exit 0 ;;
esac

# Read whitespace-split flag tokens from an rc file into global rc_tokens.
# Blank lines and # comments ignored. Missing file -> empty.
read_rc() {
    rc_tokens=()
    [[ -f "$1" ]] || return 0
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        read -ra words <<< "$line"
        rc_tokens+=("${words[@]}")
    done < "$1"
}

# ~/.dockboxrc: default flags, prepended so the command line overrides them.
read_rc "$HOME/.dockboxrc"
set -- "${rc_tokens[@]}" "$@"

# pre-strip long flags getopts can't parse
_args=()
for a in "$@"; do
    case "$a" in
        --no-ephemeral) persist_builds=1 ;;
        *) _args+=("$a") ;;
    esac
done
set -- "${_args[@]}"

while getopts ":n:d:x:e:v:HKADgGPTS" opt; do
    apply_flag "$opt" "${OPTARG:-}"
done
shift $((OPTIND - 1))

# First positional arg: if not a path and -x wasn't given, it's the tool.
# Model aliases map to claude with --model; anything else is the binary name.
if [[ -z "$entrypoint_explicit" && $# -gt 0 ]]; then
    case "$1" in
        /*|./*|.|~*) : ;;  # path — use default entrypoint
        *)
            _tool="$1"; shift
            case "$_tool" in
                haiku)  entrypoint=claude; claude_args=(--model claude-haiku-4-5-20251001 "${claude_args[@]}") ;;
                sonnet) entrypoint=claude; claude_args=(--model claude-sonnet-5-5 --effort high "${claude_args[@]}") ;;
                opus)   entrypoint=claude; claude_args=(--model claude-opus-5-5 --effort xhigh "${claude_args[@]}") ;;
                fable)  entrypoint=claude; claude_args=(--model claude-fable-5-1 "${claude_args[@]}") ;;
                codex)  entrypoint=codex; claude_args=(-m gpt-5.6-sol -c model_reasoning_effort=xhigh "${claude_args[@]}") ;;
                gpt)    entrypoint=codex; claude_args=(-m gpt-6-astra "${claude_args[@]}") ;;
                mini)   entrypoint=codex; claude_args=(-m gpt-5.4-mini "${claude_args[@]}") ;;
                spark)  entrypoint=codex; claude_args=(-m gpt-5.3-codex-spark "${claude_args[@]}") ;;
                sh|bash) entrypoint=/bin/bash; claude_args=(-l "${claude_args[@]}") ;;
                zsh)    entrypoint=/bin/zsh;  claude_args=(-l "${claude_args[@]}") ;;
                exec)   [[ $# -eq 0 ]] && { echo "dockbox exec: a command is required" >&2; exit 2; }
                        exec_cmd=("$@"); entrypoint=""; set -- ;;
                *)      entrypoint="$_tool" ;;
            esac
            ;;
    esac
fi

for arg in "$@"; do
    case "$arg" in
        /*|./*|.|~*) dirs+=("$arg") ;;
        *)           claude_args+=("$arg") ;;
    esac
done

[[ ${#dirs[@]} -eq 0 ]] && dirs=(.)
_primary_dir="$(cd "${dirs[-1]}" && pwd)"

# Project .dockboxrc: per-repo default flags, applied before any flag is
# consumed below. Gated to the safe subset — an untrusted repo must not
# silently grant sudo (-S), the Docker socket (-D), SSH-agent forwarding (-A),
# or change the tool/name (-n/-d/-x). Those live in ~/.dockboxrc only.
read_rc "$_primary_dir/.dockboxrc"
OPTIND=1
while getopts ":n:d:x:e:v:HKADgGPTS" opt "${rc_tokens[@]}"; do
    case "$opt" in
        A|D|K|S|n|d|x) echo "dockbox: ignoring -$opt in project .dockboxrc (use ~/.dockboxrc)" >&2 ;;
        *) apply_flag "$opt" "${OPTARG:-}" ;;
    esac
done
_session_dir="$HOME/.claude/projects/${_primary_dir//[^A-Za-z0-9]/-}"
_has_session=""
ls "$_session_dir"/*.jsonl >/dev/null 2>&1 && _has_session=1
# Default tool: opus at xhigh effort — the workhorse. Explicit model
# aliases (haiku/sonnet/opus/fable) and -m/--model skip this.
if [[ "$entrypoint" == "claude" ]] && \
   ! printf '%s\n' "${claude_args[@]}" | grep -qx -- '--model'; then
    claude_args=(--model claude-opus-5-5 --effort xhigh "${claude_args[@]}")
fi

if [[ ${#exec_cmd[@]} -gt 0 ]]; then
    cmd=("${exec_cmd[@]}")
elif [[ "$entrypoint" == "claude" && -n "$_has_session" ]]; then
    cmd=("$entrypoint" --resume "${claude_args[@]}")
elif [[ "$entrypoint" == "codex" ]]; then
    # Mirror the claude wrapper: inside dockbox the container is the perimeter,
    # so run codex with no inner bwrap sandbox and no approval prompts. The flag
    # is a top-level option, forwarded to the interactive TUI and to subcommands.
    cmd=("$entrypoint" --dangerously-bypass-approvals-and-sandbox "${claude_args[@]}")
else
    cmd=("$entrypoint" "${claude_args[@]}")
fi

# Name keys on the primary dir's basename (= workdir basename below), or on
# -n in its place. The dockbox- prefix is never overridable: ls, rm and prune
# all filter on it, so a container without it is invisible and never reaped.
CONTAINER_NAME="dockbox-${dir_override:-${_primary_dir##*/}}"

# Every session is a `docker exec` into a detached, long-lived container whose
# PID 1 just sleeps. Sessions are ref-counted (one marker file each) so the
# container is removed only after the LAST session exits — a session quitting
# never tears the container out from under other live execs. exec skips
# dockbox-init's gosu-drop, so the session enters as root and setpriv drops it
# to the host user: `docker exec -u` would leave it no capabilities, setpriv
# keeps CAPS ambient, and --init-groups reads the groups dockbox-init
# registered, the set `-u uid:gid` gives. It asks only for the CAPS the box was
# created with, so a box started without them still enters, without them.
# $@ = extra docker-exec flags (-w).
enter_session() {
    trap '' TSTP
    local rc=0 owner have c caps="" cap_opts=()
    owner=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER_NAME" \
        | sed -n 's/^DOCKBOX_UID=//p')
    [[ -z "$owner" || "$owner" == "$(id -u)" ]] || {
        echo "dockbox: $CONTAINER_NAME belongs to UID $owner -- use -n <name> for a box of your own" >&2
        exit 1
    }
    have=$(docker inspect -f '{{join .HostConfig.CapAdd ","}}' "$CONTAINER_NAME")
    for c in "${CAPS[@]}"; do
        [[ ",$have," == *",CAP_${c^^},"* ]] && caps+="${caps:+,}+$c"
    done
    [[ -n "$caps" ]] && cap_opts=(--inh-caps="$caps" --ambient-caps="$caps")
    docker exec "$CONTAINER_NAME" sh -c "mkdir -p /run/dockbox/sess; : > /run/dockbox/sess/$$" 2>/dev/null
    trap leave_session EXIT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
    # Forward run-time env (-e / -g token) into this exec too: unlike mounts and
    # network, env CAN be set per-exec, so a box first started without -g still
    # gets the token when a later invocation passes it.
    docker exec -it -u 0:0 -e TERM "${extra_env[@]}" "$@" "$CONTAINER_NAME" \
        setpriv --reuid="$(id -u)" --regid="$(id -g)" --init-groups \
        "${cap_opts[@]}" -- "${cmd[@]}" || rc=$?
    exit "$rc"
}

# enter_session's EXIT trap: drop this session's marker, then remove the box
# only when the marker dir lists empty; a failed listing keeps the box up.
leave_session() {
    local left
    left=$(docker exec "$CONTAINER_NAME" sh -c \
        "rm -f /run/dockbox/sess/$$; ls /run/dockbox/sess" 2>/dev/null) || return 0
    if [[ -z "$left" ]]; then
        docker rm -f -v "$CONTAINER_NAME" >/dev/null || true
    fi
}

# Container already up — re-enter it. No -w: inherit the container's working
# dir (the original project, guaranteed mounted); this invocation's workdir may
# differ and need not exist in the container. The command (tool + model/effort)
# applies; run-time flags (-v, -H, -D, -g/-G/-e, tmpfs HOME) belong to the live
# container and can't change — use -n <name> for a separate one. Gate before
# provisioning so re-entry skips the mount/settings/find work it would discard.
if [[ -n "$(docker ps -q -f "name=^${CONTAINER_NAME}$" 2>/dev/null)" ]]; then
    enter_session
fi

[[ -f "$SECCOMP" ]] || {
    echo "dockbox: no seccomp profile at $SECCOMP -- run 'make seccomp' in the dockbox source dir" >&2
    exit 1
}

mounts=()
workdir=""

[[ -f "$HOME/.dockbox_history" ]] || touch "$HOME/.dockbox_history"

for m in "${MOUNTS[@]}"; do
    src="${m%%:*}"
    [[ -e "$src" ]] && mounts+=(-v "$m")
done

# Override settings.json with sandbox disabled — settings.local.json alone does
# not suppress the sandbox restart loop when the host settings.json enables it.
# Merge host settings then force sandbox off so the host config (permissions,
# hooks) is preserved but the container never enters bubblewrap mode.
_settings=$(mktemp)
python3 -c "
import json, os, sys
path = os.path.expanduser('~/.claude/settings.json')
try:
    d = json.load(open(path))
except Exception:
    d = {}
d['sandbox'] = {'enabled': False}
d['defaultMode'] = 'bypassPermissions'
print(json.dumps(d))
" > "$_settings"
mounts+=(-v "$_settings:/home/dockbox/.claude/settings.json:ro")

docker_gid_arg=()
if [[ -n "$docker_sock" && -S /var/run/docker.sock ]]; then
    mounts+=(-v "/var/run/docker.sock:/var/run/docker.sock")
    docker_gid_arg=(--group-add "$(stat -c %g /var/run/docker.sock)")
fi

dns_args=()
if [[ ${#network_arg[@]} -eq 0 ]]; then
    gw=$(docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null)
    if [[ -n "$gw" ]] && command -v ss >/dev/null \
        && ss -ulnH 'sport = :53' | resolver_on "$gw"; then
        dns_args=(--dns "$gw")
    elif loopback_resolver /etc/resolv.conf; then
        echo "dockbox: no resolver on ${gw:-the bridge gateway}:53 -- the box keeps this network's DNS servers after a network change; see README § Roaming" >&2
    fi
fi

# gpg-agent socket is a live signing credential: forward it only on -K, and only
# when the agent actually answers -- a socket FILE can outlive its agent, and
# forwarding a dead one gives the confusing "agent not running" inside the box.
gpg_sock=$(gpgconf --list-dirs agent-socket 2>/dev/null)
if [[ -n "$gpg_forward" ]]; then
    if [[ -S "$gpg_sock" ]] && gpg-connect-agent /bye >/dev/null 2>&1; then
        mounts+=(-v "$gpg_sock:/home/dockbox/.gnupg/S.gpg-agent")
    else
        echo "dockbox: -K set but the host gpg-agent is not answering ($gpg_sock) -- run 'gpgconf --launch gpg-agent'; not forwarding" >&2
    fi
fi
for f in pubring.kbx pubring.gpg; do
    [[ -f "$HOME/.gnupg/$f" ]] && \
        mounts+=(-v "$HOME/.gnupg/$f:/home/dockbox/.gnupg/$f:ro")
done

ssh_env=()
if [[ -n "$ssh_agent" && -n "${SSH_AUTH_SOCK:-}" ]]; then
    mounts+=(-v "$SSH_AUTH_SOCK:/tmp/ssh-agent.sock")
    ssh_env=(-e SSH_AUTH_SOCK=/tmp/ssh-agent.sock)
fi

[[ -n "$gcloud_creds" && -d "$HOME/.config/gcloud" ]] && \
    mounts+=(-v "$HOME/.config/gcloud:/home/dockbox/.config/gcloud:ro")

_gitmounts=()
for dir in "${dirs[@]}"; do
    dir="$(cd "$dir" && pwd)"
    mounts+=(-v "$dir:$dir:rw")
    workdir="$dir"
    # Git worktree: its .git is a gitlink file pointing at the main repo's
    # .git/worktrees/<name>, which lives OUTSIDE this mount, so git would be
    # dead in the container. Mount the backing common git dir (the shared
    # object/ref store; the per-worktree gitdir nests under it) at its own
    # path. A normal repo's common dir is already inside the mount — the
    # prefix test skips it. If the backing store is gone (a broken gitlink),
    # warn and continue rather than fail the launch.
    gc=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
    [[ "$gc" == "$dir" || "$gc" == "$dir"/* ]] && continue
    case " ${_gitmounts[*]} " in *" $gc "*) continue ;; esac
    if gcr=$(realpath -e "$gc" 2>/dev/null); then
        _gitmounts+=("$gc")
        mounts+=(-v "$gcr:$gc:rw")
    else
        echo "dockbox: worktree git dir missing ($gc) — git disabled in box; repair the .git gitlink" >&2
    fi
done

for vol in "${extra_vols[@]}"; do
    mode="ro"
    [[ "$vol" == *:rw ]] && { mode="rw"; vol="${vol%:rw}"; } || vol="${vol%:ro}"
    src="$(cd "$vol" && pwd)"
    mounts+=(-v "$src:$src:$mode")
done

# Run as root; dockbox-init creates a /etc/passwd entry for the host invoker,
# chowns $HOME and every overmount to their UID/GID, then gosu-drops. Image
# has no baked user — it works for any host UID without rebuilding.
user_arg=(--user 0:0)
extra_env+=(-e "DOCKBOX_UID=$(id -u)")
extra_env+=(-e "DOCKBOX_GID=$(id -g)")
extra_env+=(-e "DOCKBOX_USER=$(id -un)")
[[ -n "$grant_sudo" ]] && extra_env+=(-e DOCKBOX_SUDO=1)

cap_args=()
for c in "${CAPS[@]}"; do
    cap_args+=(--cap-add "$c")
done

# Fresh tmpfs $HOME for the runtime user, chowned by dockbox-init. Bind
# mounts of ~/.claude, ~/.gitconfig, ~/.zsh_history etc. nest into this.
mounts+=(--tmpfs /home/dockbox:rw,exec,mode=1777)

if [[ -d "$HOME/.claude" ]]; then
    mkdir -p -m 700 "$HOME/.claude/sessions"
    mounts+=(--tmpfs "/home/dockbox/.claude/sessions:rw,mode=0700,uid=$(id -u),gid=$(id -g)")
fi

mounts+=(--tmpfs /tmp:rw,exec,mode=1777)

# Cargo target dir: dedicated tmpfs so builds never write to the host workdir.
# CARGO_TARGET_DIR tells Cargo to use this path regardless of project layout.
mounts+=(--tmpfs /tmp/cargo-target:rw,exec,mode=1777)
extra_env+=(-e CARGO_TARGET_DIR=/tmp/cargo-target)
chown_paths=("/home/dockbox")
# The -K gpg-socket mount makes Docker auto-create /home/dockbox/.gnupg as root;
# gpg (running as the drop-in user) then can't write its trustdb lock there.
# Chown just the dir (dockbox-init chowns non-recursively, so the mounted socket
# inside is untouched) so signing works.
[[ -n "$gpg_forward" ]] && chown_paths+=("/home/dockbox/.gnupg")

# Ephemeral overmounts (default): each build-artifact dir found under workdir
# becomes a fresh empty mount inside the container, chowned by dockbox-init.
#   tmpfs (default) — kernel tmpfs (RAM-backed).
#   -T              — anonymous Docker volume (disk-backed).
# Disable with -P / --no-ephemeral.
#
# Cap depth at 4: covers workspace patterns (./node_modules,
# ./packages/foo/node_modules, ./apps/bar/dist). Vendored pnpm/yarn
# stores nest hundreds of node_modules deeper — overmounting each
# blows ARG_MAX, and they're internal caches the container won't write.
# Single find with -prune on any name so we don't double-mount nested
# artifacts that a parent overmount already covers.
if [[ -z "$persist_builds" ]]; then
    find_expr=()
    for name in "${EPHEMERAL_DIRS[@]}"; do
        [[ ${#find_expr[@]} -gt 0 ]] && find_expr+=(-o)
        find_expr+=(-name "$name")
    done
    for d in "${dirs[@]}"; do
        absdir="$(cd "$d" && pwd)"
        while IFS= read -r found; do
            if [[ -n "$eph_no_tmpfs" ]]; then
                mounts+=(-v "$found")
            else
                mounts+=(--tmpfs "$found:rw,exec,mode=1777")
            fi
            chown_paths+=("$found")
        done < <(find "$absdir" -maxdepth 4 -type d \
            \( "${find_expr[@]}" \) -prune -print 2>/dev/null)
    done
fi

eph_list=$(IFS=:; echo "${chown_paths[*]}")
extra_env+=(-e "DOCKBOX_EPH_PATHS=$eph_list")

# screenshot sharing: host /tmp/capture.png -> project capture.png
[[ -f /tmp/capture.png ]] || touch /tmp/capture.png
mounts+=(-v "/tmp/capture.png:$workdir/capture.png:ro")

# overmount so container can't modify project .dockboxrc
[[ -f "$workdir/.dockboxrc" ]] && \
    mounts+=(-v "/dev/null:$workdir/.dockboxrc:ro")

docker rm -f -v "$CONTAINER_NAME" 2>/dev/null || true

# Start detached with a sleeper PID 1 (--init reaps zombies) so the container's
# lifetime is independent of any session. dockbox-init runs the per-user setup,
# touches /run/dockbox/ready, then holds the container open with sleep infinity.
# The seccomp profile is Docker's default plus io_uring, which the default
# denies and Agave's solana-test-validator needs.
docker run -d --init \
    --name "$CONTAINER_NAME" \
    --entrypoint /usr/local/bin/dockbox-init \
    "${user_arg[@]}" \
    --security-opt "seccomp=$SECCOMP" \
    "${cap_args[@]}" \
    "${network_arg[@]}" \
    "${dns_args[@]}" \
    "${docker_gid_arg[@]}" \
    -e HOME=/home/dockbox \
    -e TERM \
    ${CLAUDE_CODE_OAUTH_TOKEN:+-e CLAUDE_CODE_OAUTH_TOKEN} \
    ${OPENAI_API_KEY:+-e OPENAI_API_KEY} \
    ${CODEX_API_KEY:+-e CODEX_API_KEY} \
    "${extra_env[@]}" \
    "${ssh_env[@]}" \
    "${mounts[@]}" \
    -w "$workdir" \
    -- "$IMAGE" \
    sleep infinity >/dev/null || { echo "Failed to start container" >&2; exit 1; }

# Wait for dockbox-init to finish per-user setup before the first session.
for _ in $(seq 1 100); do
    docker exec "$CONTAINER_NAME" test -f /run/dockbox/ready 2>/dev/null && break
    docker ps -q -f "name=^${CONTAINER_NAME}$" >/dev/null 2>&1 || \
        { echo "Container exited during startup" >&2; docker logs "$CONTAINER_NAME" 2>&1 | tail -20; exit 1; }
    sleep 0.1
done

enter_session -w "$workdir"
