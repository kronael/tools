#!/bin/bash
set -Eeuo pipefail

username="${DOCKBOX_USER:-dockbox}"
case "$username" in *[!A-Za-z0-9_-]*|"") username=dockbox ;; esac
user_uid="${DOCKBOX_UID:-1000}"
case "$user_uid" in ""|*[!0-9]*) user_uid=1000 ;; esac
user_gid="${DOCKBOX_GID:-1000}"
case "$user_gid" in ""|*[!0-9]*) user_gid=1000 ;; esac
home_dir="${HOME:-/home/dockbox}"
[[ $# -gt 0 ]] || set -- /bin/zsh

if [[ "$(id -u)" != 0 ]]
then
    /usr/local/bin/dockbox-codex-bridge || true
    exec "$@"
fi

getent passwd "$user_uid" >/dev/null ||
    echo "$username:x:$user_uid:$user_gid::$home_dir:/bin/zsh" >> /etc/passwd
getent group "$user_gid" >/dev/null ||
    echo "$username:x:$user_gid:" >> /etc/group
getent shadow "$username" >/dev/null ||
    echo "$username:!:19000:0:99999:7:::" >> /etc/shadow
if [[ "${DOCKBOX_SUDO:-}" == 1 ]]
then
    echo "$username ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/dockbox-$username"
    chmod 0440 "/etc/sudoers.d/dockbox-$username"
fi
[[ ! -d "$home_dir" ]] || chown "$user_uid:$user_gid" "$home_dir"
IFS=: read -ra paths <<< "${DOCKBOX_EPH_PATHS:-}"
for path in "${paths[@]}"
do
    [[ ! -d "$path" ]] || chown "$user_uid:$user_gid" "$path"
done
for gid in $(id -G)
do
    case "$gid" in 0|"$user_gid") continue ;; esac
    group=$(getent group "$gid" || true)
    group_name=$(cut -d: -f1 <<< "$group")
    members=$(cut -d: -f4 <<< "$group")
    [[ -n "$group_name" ]] || group_name="hostgrp$gid"
    case ",$members," in *",$username,"*) continue ;; esac
    [[ -z "$members" ]] || members+=,
    members+="$username"
    sed -i "/^$group_name:/d" /etc/group
    echo "$group_name:x:$gid:$members" >> /etc/group
done
mkdir -p /run/dockbox/sess
gosu "$username" env HOME="$home_dir" \
    /usr/local/bin/dockbox-codex-bridge || true

if [[ "${DOCKBOX_NESTED_DOCKER:-}" != 1 ]]
then
    touch /run/dockbox/ready
    exec gosu "$username" "$@"
fi

daemon_pid=""
command_pid=""
cleanup() {
    rm -f /run/dockbox/ready
    [[ -z "$command_pid" ]] || kill "$command_pid" 2>/dev/null || true
    [[ -z "$daemon_pid" ]] || kill "$daemon_pid" 2>/dev/null || true
    wait || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
export DOCKBOX_GID="$user_gid"
/usr/local/bin/dockbox-docker &
daemon_pid=$!
ready=""
for ((i = 0; i < 100; i++))
do
    if ! kill -0 "$daemon_pid" 2>/dev/null
    then
        echo 'dockbox: nested Docker exited during startup' >&2
        exit 1
    fi
    if docker -H unix:///var/run/docker.sock info >/dev/null 2>&1
    then
        ready=1
        break
    fi
    sleep 0.1
done
[[ -n "$ready" ]] || {
    echo 'dockbox: nested Docker did not become ready' >&2
    exit 1
}
gosu "$username" "$@" &
command_pid=$!
touch /run/dockbox/ready
status=0
wait -n -p stopped "$daemon_pid" "$command_pid" || status=$?
if [[ "$stopped" == "$daemon_pid" ]]
then
    echo 'dockbox: nested Docker exited' >&2
    exit 1
fi
exit "$status"
